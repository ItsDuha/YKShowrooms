@model DatabaseModel.Models.Visitor

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Showrooms Service";
}

<!-- Light/Dark mode toggle will be injected by JS -->

<style>
    body {
        background: #f5f6f8;
        font-family: 'Segoe UI', sans-serif;
    }

    .logo {
        width: 50px;
        height: 50px;
        border: 4px solid #0b1b3f;
        border-radius: 50%;
        margin: auto;
        position: relative;
    }

        .logo::after {
            content: "";
            width: 12px;
            height: 12px;
            background: gold;
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

    /* RTL mode */
    .rtl {
        direction: rtl;
        text-align: right;
    }

        /* Fix labels + inputs alignment */
        .rtl .form-label {
            text-align: right;
            display: block;
        }

        .rtl input,
        .rtl select,
        .rtl textarea {
            text-align: right;
        }

        /* Optional: fix spacing between fields */
        .rtl .row {
            flex-direction: row-reverse;
        }




    /* ── Marketing source pills ── */
    .source-options {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
    }

        .source-options input[type="radio"] {
            display: none;
        }

        .source-options label {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 7px 14px;
            border: 1.5px solid #d1d5db;
            border-radius: 50px;
            font-size: 13.5px;
            cursor: pointer;
            background: #fff;
            color: #555;
            transition: all 0.18s ease;
            user-select: none;
        }

            .source-options label:hover {
                border-color: #0b1b3f;
                color: #0b1b3f;
            }

        .source-options input[type="radio"]:checked + label {
            background: #0b1b3f;
            border-color: #0b1b3f;
            color: #fff;
            font-weight: 500;
        }

    .source-icon {
        font-size: 15px;
        line-height: 1;
    }

    /* Other box slide animation */
    #other-source-wrap {
        overflow: hidden;
        transition: all 0.2s ease;
    }

    .rtl .source-options {
        flex-direction: row-reverse;
    }
</style>

<div class="container">
    <div class="text-danger">
        @Html.ValidationSummary(false)
    </div>
    <!-- HEADER -->
    <div class="text-center mt-4">
        <div class="logo"></div>

        <h2 class="fw-bold mt-3" id="txt-page-title">Showrooms Service</h2>
        <p class="text-muted" id="txt-page-subtitle">Welcome to Showrooms Service</p>
    </div>

    <!-- CARD -->
    <div class="card shadow-sm mt-4 mx-auto" style="max-width:500px; border-radius:15px;">
        <div class="card-body">

            <h5 class="fw-semibold" id="txt-checkin">Check In</h5>
            <hr />

            <form method="post">

                <div class="row g-3">

                    <!-- Name -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-fullname">Full Name</label>
                        <input asp-for="Name" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-phone">Phone Number</label>
                        <input asp-for="Phone" class="form-control" placeholder="+973 12345678" />
                        <span asp-validation-for="Phone" class="text-danger small"></span>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-email">Email (Optional)</label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <!-- CPR -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-cpr">CPR Number</label>
                        <input asp-for="Cpr" class="form-control" />
                        <span asp-validation-for="Cpr" class="text-danger small"></span>
                    </div>

                    <!-- Showroom -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-showroom">Showroom</label>
                        <select asp-for="ShowroomId" class="form-select">
                            <option value="0">Select a showroom</option>
                            @foreach (var s in ViewBag.Showrooms)
                            {
                                <option value="@s.Id">@s.Name</option>
                            }
                        </select>
                        <span asp-validation-for="ShowroomId" class="text-danger small"></span>
                    </div>

                    <!-- Product -->
                    <div class="col-md-6">
                        <label class="form-label" id="txt-car-model">Car Model of Interest</label>
                        <select asp-for="ProductId" class="form-select">
                            <option value="">Not sure yet</option>
                            @foreach (var p in ViewBag.Products)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        </select>
                    </div>

                    <!-- Salesperson -->
                    <div class="col-md-12">
                        <label class="form-label" id="txt-salesperson">Assigned Salesperson</label>
                        <select asp-for="SalespersonId" class="form-select">
                            <option value="">Select a salesperson (optional)</option>
                            @foreach (var sp in ViewBag.Salespersons)
                            {
                                <option value="@sp.Id">@sp.Name</option>
                            }
                        </select>
                    </div>


                    <!-- Notes -->
                    <div class="col-md-12">
                        <label class="form-label" id="txt-notes">Notes (Optional)</label>
                        <textarea asp-for="Notes" id="input-notes" class="form-control" placeholder="Any specific requirements?"></textarea>
                    </div>

                </div>

                <!-- How did you hear about us? -->
                <div class="mt-3">
                    <label class="form-label fw-semibold" id="txt-marketing-source">How did you hear about us?</label>
                    <div class="source-options" id="source-options-container">

                        <input type="radio" name="MarketingSource" value="Instagram" id="src-Instagram" />
                        <label for="src-Instagram">
                            <span class="source-icon">📸</span>
                            <span class="src-label" data-key="srcInstagram">Instagram</span>
                        </label>

                        <input type="radio" name="MarketingSource" value="TikTok" id="src-TikTok" />
                        <label for="src-TikTok">
                            <span class="source-icon">🎵</span>
                            <span class="src-label" data-key="srcTikTok">TikTok</span>
                        </label>

                        <input type="radio" name="MarketingSource" value="YouTube" id="src-YouTube" />
                        <label for="src-YouTube">
                            <span class="source-icon">▶️</span>
                            <span class="src-label" data-key="srcYouTube">YouTube</span>
                        </label>

                        <input type="radio" name="MarketingSource" value="Website" id="src-Website" />
                        <label for="src-Website">
                            <span class="source-icon">🌐</span>
                            <span class="src-label" data-key="srcWebsite">Website</span>
                        </label>

                        <input type="radio" name="MarketingSource" value="Friend" id="src-Friend" />
                        <label for="src-Friend">
                            <span class="source-icon">👥</span>
                            <span class="src-label" data-key="srcFriend">Friend</span>
                        </label>

                        <input type="radio" name="MarketingSource" value="Walk-in" id="src-Walk-in" />
                        <label for="src-Walk-in">
                            <span class="source-icon">🚶</span>
                            <span class="src-label" data-key="srcWalkin">Walk-in</span>
                        </label>

                        

                    </div>

                    
                </div>


                <button type="submit" class="btn btn-dark w-100 mt-4" id="txt-submit">
                    Complete Check-in
                </button>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    
    
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/site.js"></script>
    <script>
            /* ── TRANSLATIONS ── */
            const homeTranslations = {
            en: {
                pageTitle:       "Showrooms Service",
                pageSubtitle:    "Welcome to Showrooms Service",
                checkIn:         "Check In",
                fullName:        "Full Name",
                phoneNumber:     "Phone Number",
                email:           "Email (Optional)",
                cpr:             "CPR Number",
                showroom:        "Showroom",
                selectShowroom:  "Select a showroom",
                carModel:        "Car Model of Interest",
                notSure:         "Not sure yet",
                salesperson:     "Assigned Salesperson",
                selectSales:     "Select a salesperson (optional)",
                notes:           "Notes (Optional)",
                notesPH:         "Any specific requirements?",
                marketingSource: "How did you hear about us?",
                srcInstagram:    "Instagram",
                srcTikTok:       "TikTok",
                srcWebsite:      "Website",
                srcFriend:       "Friend",
                srcWalkin:       "Walk-in",
                srcOther:        "Other",
                otherPH:         "Please tell us how you heard about us...",
                submit:          "Complete Check-in",
                langBtn:         "English",
        srcYouTube: "YouTube"
            },
            ar: {
                pageTitle:       "خدمة المعارض",
                pageSubtitle:    "مرحباً بك في خدمة المعارض",
                checkIn:         "تسجيل الدخول",
                fullName:        "الاسم الكامل",
                phoneNumber:     "رقم الهاتف",
                email:           "البريد الإلكتروني (اختياري)",
                cpr:             "الرقم الشخصي",
                showroom:        "المعرض",
                selectShowroom:  "اختر معرضاً",
                carModel:        "موديل السيارة المفضل",
                notSure:         "غير متأكد بعد",
                salesperson:     "مندوب المبيعات",
                selectSales:     "اختر مندوباً (اختياري)",
                notes:           "ملاحظات (اختياري)",
                notesPH:         "أي متطلبات خاصة؟",
                marketingSource: "كيف سمعت عنا؟",
                srcInstagram:    "إنستغرام",
                srcTikTok:       "تيك توك",
                srcWebsite:      "الموقع الإلكتروني",
                srcFriend:       "صديق",
                srcWalkin:       "زيارة مباشرة",
                srcOther:        "أخرى",
                otherPH:         "يرجى إخبارنا كيف سمعت عنا...",
                submit:          "إتمام تسجيل الدخول",
                langBtn:         "العربية",
                srcYouTube: "يوتيوب"
            }
        };

        function translateHomePage(lang) {
            const t      = homeTranslations[lang];
            const set    = (id, val)  => { const el = document.getElementById(id);  if (el) el.innerText   = val; };
            const setPH  = (id, val)  => { const el = document.getElementById(id);  if (el) el.placeholder = val; };
            const setOpt = (sel, val) => { const el = document.querySelector(sel);  if (el) el.innerText   = val; };

            set('txt-page-title',       t.pageTitle);
            set('txt-page-subtitle',    t.pageSubtitle);
            set('txt-checkin',          t.checkIn);
            set('txt-fullname',         t.fullName);
            set('txt-phone',            t.phoneNumber);
            set('txt-email',            t.email);
            set('txt-cpr',              t.cpr);
            set('txt-showroom',         t.showroom);
            set('txt-car-model',        t.carModel);
            set('txt-salesperson',      t.salesperson);
            set('txt-notes',            t.notes);
            set('txt-marketing-source', t.marketingSource);
            set('txt-submit',           t.submit);
            set('langBtnLabel',         t.langBtn);

            setPH('input-notes',        t.notesPH);
            setPH('other-source-input', t.otherPH);

            setOpt('select[name="ShowroomId"]    option[value="0"]', t.selectShowroom);
            setOpt('select[name="ProductId"]     option[value=""]',  t.notSure);
            setOpt('select[name="SalespersonId"] option[value=""]',  t.selectSales);

            // Translate pill labels
            document.querySelectorAll('.src-label').forEach(el => {
                const key = el.getAttribute('data-key');
                if (t[key]) el.innerText = t[key];
            });

            localStorage.setItem('lang',     lang);
            localStorage.setItem('siteLang', lang);

            const langField = document.getElementById('hidden-lang');
            if (langField) langField.value = lang;

            if (lang === 'ar') {
                document.documentElement.setAttribute('dir', 'rtl');
                document.body.classList.add('rtl');
            } else {
                document.documentElement.setAttribute('dir', 'ltr');
                document.body.classList.remove('rtl');
            }
        }

        // Show/hide the Other text box when a pill is clicked
                document.addEventListener('DOMContentLoaded', function () {

            document.querySelectorAll('.source-options input[type="radio"]').forEach(function (radio) {
                radio.addEventListener('change', function () {
                    // Clear the validation message when a source is selected
                    const field = document.querySelector('[data-valmsg-for="MarketingSource"]');
                    if (field) field.innerText = '';
                });
            });

            // Apply saved language on page load
            const lang = localStorage.getItem('lang') || 'en';
            translateHomePage(lang);
        });

        function toggleLanguage() {
            const current = localStorage.getItem('lang') || 'en';
            translateHomePage(current === 'en' ? 'ar' : 'en');
        }
    </script>

}