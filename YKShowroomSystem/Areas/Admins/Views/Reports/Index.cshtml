@using DatabaseModel.Models
@model List<Visitor>

@{
    Layout = "~/Areas/Admins/Views/Shared/_Layout.cshtml";
}



<h4 class="fw-bold mb-4">Reports</h4>

<!-- SUCCESS MESSAGE -->
@if (TempData["msg"] != null)
{
    <div id="successMsg" class="alert alert-success shadow-sm">
        @TempData["msg"]
    </div>
}

<!-- TABS -->
<div class="mb-4 d-flex gap-2">

    <a href="?tab=daily"
       class="btn btn-light px-4 @(ViewBag.Tab == "daily" ? "active-tab" : "")">
        Daily Walk-ins
    </a>

    <a href="?tab=missed"
       class="btn btn-light px-4 @(ViewBag.Tab == "missed" ? "active-tab" : "")">
        Missed Follow-ups
    </a>

</div>

<div class="card p-4 shadow-sm">

    <!-- FILTERS -->

    @if(ViewBag.Tab == "daily")
{
        <form method="get" id="filterForm" class="row g-3 mb-4">

            <!-- Search -->
            <div class="col-md-4 position-relative">
                <i class="bi bi-search position-absolute"
                   style="top:12px; left:12px; color:#aaa;"></i>

                <input type="text" name="search" id="searchInput"
                       class="form-control ps-5 shadow-sm"
                       placeholder="Search name, phone..." />
            </div>

            <!-- Showroom -->
            <div class="col-md-3">
                <select name="showroomId" class="form-select shadow-sm"
                        onchange="submitForm()">
                    <option value="0">All Showrooms</option>
                    @foreach (var s in ViewBag.Showrooms)
                    {
                        <option value="@s.Id" selected="@(ViewBag.SelectedShowroom == s.Id)">
                            @s.Name
                        </option>
                    }
                </select>
            </div>

            <!-- Status -->
            <div class="col-md-3">
                <select name="status" class="form-select shadow-sm"
                        onchange="submitForm()">
                    <option value="All">Any Status</option>
                    <option value="pending" selected="@(ViewBag.SelectedStatus == "pending")">Pending</option>
                    <option value="contacted" selected="@(ViewBag.SelectedStatus == "contacted")">Contacted</option>
                    <option value="not_interested" selected="@(ViewBag.SelectedStatus == "not_interested")">Not Interested</option>
                </select>
            </div>

            <!-- Export -->
            <div class="col-md-2">
                <a href="/Admins/Reports/Export?search=@ViewBag.Search&showroomId=@ViewBag.SelectedShowroom&status=@ViewBag.SelectedStatus"
                   class="btn btn-dark w-100 shadow-sm">
                    <i class="bi bi-download"></i> Export
                </a>
            </div>

        </form>
    <!-- MAIN TABLE (Daily walk-ins) -->
    <table class="table table-hover align-middle">

        <thead class="table-light">
            <tr>
                <th>Visitor</th>
                <th>CPR</th>
                <th>Showroom</th>
                <th>Status</th>
                <th>Score</th>
                <th>Visit Time</th>
                <th>View</th>
                <th>Delete</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>

                    <td>
                        <strong>@item.Name</strong><br />
                        <small class="text-muted">@item.Phone</small>
                    </td>

                    <td>@item.Cpr</td>

                    <td>@item.Showroom?.Name</td>

                    <!-- STATUS -->
                    <td>
                        <form method="post" action="/Admins/Reports/UpdateStatus">
                            <input type="hidden" name="id" value="@item.Id" />

                            <select name="status"
                                    class="form-select form-select-sm status-select
                                    @(item.FollowUpStatus == "pending" ? "status-pending" :
                                              item.FollowUpStatus == "contacted" ? "status-contacted" :
                                              "status-not")"
                                    onchange="this.form.submit()">

                                <option value="pending" selected="@(item.FollowUpStatus == "pending")">Pending</option>
                                <option value="contacted" selected="@(item.FollowUpStatus == "contacted")">Contacted</option>
                                <option value="not_interested" selected="@(item.FollowUpStatus == "not_interested")">Not Interested</option>

                            </select>
                        </form>
                    </td>

                    <!-- SCORE -->
                    <td>
                        <span class="badge bg-light text-dark">@item.Score/100</span>
                    </td>

                    <!-- DATE -->
                    <td>
                        @item.VisitedAt?.ToString("dd MMM yyyy")<br />
                        <small class="text-muted">@item.VisitedAt?.ToString("HH:mm")</small>
                    </td>

                    <!-- VIEW -->
                    <td class="text-end">
                        <a href="/Admins/Reports/Details/@item.Id"
                           class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-eye"></i>
                        </a>
                    </td>

                    <!-- DELETE -->
                    <td class="text-end">
                        <button class="btn btn-outline-danger btn-sm"
                                    onclick="openDelete(@item.Id, '@ViewBag.Tab')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>

                </tr>
            }
        </tbody>

    </table>
    }

    <!--Missed Follow up report-->
    @if (ViewBag.Tab == "missed")
    {
        <div class="card p-4 shadow-sm mt-3">

            <!-- HEADER -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h5 class="fw-bold">Missed Follow-up Report</h5>
                    <small class="text-muted">
                        Visitors still in Pending status
                    </small>
                </div>
            </div>

            <!-- SEARCH & Filter -->
            <form method="get" id="missedForm" class="d-flex gap-2 mb-3">

             
                <input type="hidden" name="tab" value="missed" />

                <!-- SEARCH -->
                <div class="position-relative" style="width: 280px;">
                    <i class="bi bi-search position-absolute"
                       style="top:10px; left:10px; color:#aaa;"></i>

                    <input type="text"
                           name="search"
                           id="missedSearch"
                           value="@ViewBag.Search"
                           class="form-control ps-4"
                           placeholder="Search by name or phone..." />
                </div>

                <!-- TIME FILTER -->
                <select name="range"
                        class="form-select shadow-sm"
                        style="width:180px;"
                        onchange="document.getElementById('missedForm').submit()">

                    <option value="1" selected="@(ViewBag.Range == 1)">Today only</option>
                    <option value="3" selected="@(ViewBag.Range == 3)">Last 3 days</option>
                    <option value="7" selected="@(ViewBag.Range == 7)">Last 7 days</option>
                    <option value="30" selected="@(ViewBag.Range == 30)">Last 30 days</option>

                </select>
                <div class="position-relative">
                    <a href="/Admins/Reports/ExportMissed?search=@ViewBag.Search&range=@ViewBag.Range"
                       class="btn btn-dark w-100 shadow-sm">
                        <i class="bi bi-download"></i> Export CSV
                    </a>
                </div>

            </form>

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Visitor</th>
                        <th>Visited</th>
                        <th>Overdue</th>
                        <th>Showroom</th>
                        <th>Salesperson</th>
                        <th>Required Action</th>
                        <th>View</th>
                        <th>Delete</th>
                    </tr>
                </thead>

                <tbody>

                    @if (ViewBag.MissedData != null && ViewBag.MissedData.Count > 0)
                    {
                        foreach (var item in ViewBag.MissedData)
                        {
                            var v = item.Visitor;
                            var days = item.Days;

                            string badge =
                            days <= 1 ? "badge bg-warning text-dark" :
                            days <= 3 ? "badge bg-orange text-white" :
                                                            "badge bg-danger";

                            <tr>

                                <td>
                                    <strong>@v.Name</strong><br />
                                    <small class="text-muted">@v.Phone</small>
                                </td>

                                <td>
                                    @v.VisitedAt?.ToString("ddd dd MMM")<br />
                                    <small>@v.VisitedAt?.ToString("HH:mm")</small>
                                </td>

                                <td>
                                    <span class="@badge">
                                        @days day(s) ago
                                    </span>
                                </td>

                                <td>@v.Showroom?.Name</td>

                                <td>
                                    <form method="post" action="/Admins/Reports/AssignSalesperson">

                                        <input type="hidden" name="visitorId" value="@v.Id" />

                                        <select name="salespersonId"
                                                class="form-select shadow-sm"
                                                onchange="this.form.submit()">

                                            <option value="">Unassigned</option>

                                            @foreach (var sp in ViewBag.Salespersons)
                                            {
                                                <option value="@sp.Id"
                                                        selected="@(v.SalespersonId == sp.Id)">
                                                    @sp.Name
                                                </option>
                                            }

                                        </select>

                                    </form>
                                </td>

                                <td>
                                    <a href="mailto:@v.Email"
                                       class="btn btn-primary btn-sm">
                                        <i class="bi bi-envelope"></i> Email
                                    </a>
                                </td>

                                <td>
                                    <a href="/Admins/Reports/Details/@v.Id?tab=missed"
                                       class="btn btn-outline-secondary btn-sm">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>

                                <td>
                                    <button class="btn btn-outline-danger btn-sm"
                                            onclick="openDelete(@v.Id, 'missed')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                No missed follow-ups found
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <!-- PAGINATION -->
    <div class="d-flex justify-content-between mt-3 align-items-center">
        <span class="text-muted">Page @ViewBag.Page of @ViewBag.TotalPages</span>

        <div>
            @if (ViewBag.Page > 1)
            {
                <a href="?tab=@ViewBag.Tab&page=@(ViewBag.Page - 1)&search=@ViewBag.Search&showroomId=@ViewBag.SelectedShowroom&status=@ViewBag.SelectedStatus"
                   class="btn btn-outline-secondary btn-sm me-2">
                    Previous
                </a>
            }

            @if (ViewBag.Page < ViewBag.TotalPages)
            {
                <a href="?tab=@ViewBag.Tab&page=@(ViewBag.Page + 1)&search=@ViewBag.Search&showroomId=@ViewBag.SelectedShowroom&status=@ViewBag.SelectedStatus"
                   class="btn btn-dark btn-sm">
                    Next
                </a>
            }
        </div>
    </div>

</div>

<!-- DELETED TABLE -->
<div class="card p-4 shadow-sm mt-4">

    <h5 class="mb-3 fw-semibold">Deleted Visitors</h5>

    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Phone</th>
                <th>Restore</th>
            </tr>
        </thead>

        <tbody>
            @if (ViewBag.Deleted.Count == 0)
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">
                        No deleted visitors yet
                    </td>
                </tr>
            }
            else
            {
                foreach (var d in ViewBag.Deleted)
                {
                    <tr>
                        <td>@d.Name</td>
                        <td>@d.Phone</td>
                        <td>
                            <a href="/Admins/Reports/Restore?id=@d.Id&tab=@ViewBag.Tab"
                               class="btn btn-success btn-sm">
                                Restore
                            </a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

</div>

<!-- DELETE MODAL -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content shadow">

            <div class="modal-header">
                <h5 class="modal-title fw-semibold">Delete Record</h5>
            </div>

            <div class="modal-body text-muted">
                Are you sure you want to delete this record?
            </div>

            <div class="modal-footer">
                <button class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                <a id="deleteBtn" class="btn btn-danger">Delete</a>
            </div>

        </div>
    </div>
</div>

@section Styles
{
    <style>

        /* PAGE BACKGROUND */
        body {
            background-color: #f5f6f8;
        }

        /* CARD */
        .card {
            border-radius: 12px;
            border: 1px solid #e9ecef;
            background: white;
        }

        /* TABLE */
        .table {
            margin-bottom: 0;
        }

            .table thead th {
                font-size: 13px;
                color: #6c757d;
                font-weight: 500;
                border-bottom: 1px solid #e9ecef;
            }

            .table tbody tr {
                border-bottom: 1px solid #f1f3f5;
            }

                .table tbody tr:hover {
                    background-color: #f9fafb;
                }

        /* VISITOR TEXT */
        td strong {
            font-weight: 600;
            font-size: 14px;
        }

        td small {
            color: #6c757d;
        }

        /* STATUS SELECT */
        .status-select {
            border-radius: 20px;
            padding: 4px 10px;
            font-size: 12px;
            border: none;
            outline: none;
            font-weight: 500;
            cursor: pointer;
        }

        /* COLORS */
        .status-pending {
            background: #fff3cd;
            color: #856404;
        }

        .status-contacted {
            background: #d4edda;
            color: #155724;
        }

        .status-not {
            background: #f8d7da;
            color: #721c24;
        }

        /* SCORE */
        .badge {
            background: #f1f3f5 !important;
            color: #212529 !important;
            font-weight: 500;
        }

        /* BUTTONS */
        .btn-outline-secondary,
        .btn-outline-danger {
            border: none;
            background: transparent;
        }

            .btn-outline-secondary:hover {
                background: #f1f3f5;
            }

            .btn-outline-danger:hover {
                background: #ffe3e3;
            }

        /* EXPORT BUTTON */
        .btn-dark {
            background: #212529;
            border-radius: 8px;
        }

        /* FILTERS */
        #filterForm input,
        #filterForm select {
            border-radius: 8px;
            border: 1px solid #e9ecef;
        }

        /* PAGINATION */
        .btn-dark.btn-sm {
            border-radius: 6px;
        }

        .dropdown-menu input {
            border-radius: 6px;
        }

        .dropdown-item.active {
            background-color: #d4a017;
            color: black;
        }

    </style>
}


@section Scripts
{
    <script>
        function submitForm() {
            document.getElementById("filterForm").submit();
        }

                function openDelete(id, tab) {
        document.getElementById("deleteBtn").href =
               "/Admins/Reports/Delete?id=" + id + "&tab=" + tab;

           new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        // AUTO HIDE SUCCESS MESSAGE
        setTimeout(() => {
            let msg = document.getElementById("successMsg");
            if (msg) {
                msg.style.transition = "0.5s";
                msg.style.opacity = "0";
                setTimeout(() => msg.remove(), 500);
            }
        }, 2000);
    </script>

    <script>
        let timeout = null;

        document.getElementById("searchInput").addEventListener("keyup", function () {

            clearTimeout(timeout);

            timeout = setTimeout(() => {
                document.getElementById("filterForm").submit();
            }, 400);
        });
    </script>

    <!--Live serach-->
    <script>
        let missedTimeout;

        document.getElementById("missedSearch")?.addEventListener("keyup", function () {

            clearTimeout(missedTimeout);

            missedTimeout = setTimeout(() => {
                document.getElementById("missedForm").submit();
            }, 400);

        });
    </script>
}