@model DatabaseModel.Models.Visitor

@{
    Layout = "~/Areas/Admins/Views/Shared/_Layout.cshtml";

    var score = Model.Score ?? 0;

    var level = score >= 70 ? "High"
                : score >= 40 ? "Medium"
                : "Low";

    var progressClass = score >= 70 ? "bg-success"
                      : score >= 40 ? "bg-warning"
                      : "bg-secondary";
}

<div class="mb-3">
    <a href="/Admins/Reports/Index?tab=@ViewBag.Tab" class="text-decoration-none" id="txt-back">
        ← Back to Reports
    </a>
</div>

@if (TempData["msg"] != null)
{
    <div id="successMsg" class="alert alert-success">
        @TempData["msg"]
    </div>
}

<div class="row align-items-start">

    <!-- LEFT CARD -->
    <div class="col-md-4">

        <div class="p-4 text-white"
             style="background:#0b1b3f; border-radius:12px;">

            <div class="text-center mb-3">
                <div style="width:70px;height:70px;background:gold;border-radius:50%;
                    display:flex;align-items:center;justify-content:center;
                    margin:auto;font-weight:bold;">
                    @Model.Name.Substring(0, 1)
                </div>

                <h5 class="mt-3">@Model.Name</h5>

                <span class="badge @progressClass">
                    <span id="txt-level">@level</span> Lead - @score/100
                </span>
            </div>

            <hr />

            <p><i class="bi bi-telephone"></i> @Model.Phone</p>
            <p><i class="bi bi-calendar"></i> @Model.VisitedAt?.ToString("dd/MM/yyyy")</p>
            <p><i class="bi bi-clock"></i> @Model.VisitedAt?.ToString("HH:mm")</p>

            <hr />

            <div>
                <strong id="txt-lead-score-label">Lead Score</strong>

                <div class="progress mt-2">
                    <div class="progress-bar @progressClass"
                         style="width:@score%">
                    </div>
                </div>

                <small>@score/100</small>
            </div>

            <!-- SMART RECOMMENDATION -->
            <div class="alert alert-light border mt-3">

                <strong id="txt-recommendation-label">Recommendation:</strong>

                @if ((Model.Score ?? 0) >= 70)
                {
                    <span id="txt-recommendation-text">
                        Contact immediately and prioritize follow-up.
                    </span>
                }
                else if ((Model.Score ?? 0) >= 40)
                {
                    <span id="txt-recommendation-text">
                        Follow up within 24 hours.
                    </span>
                }
                else
                {
                    <span id="txt-recommendation-text">
                        Low-priority lead. Keep for future campaigns.
                    </span>
                }

            </div>

            <!-- VIP CUSTOMER -->
            @if (Model.IsReturning == true && (Model.Score ?? 0) >= 70)
            {
                <div class="alert alert-warning mt-3 mb-0 text-dark">

                    <strong id="txt-vip-title">VIP Customer</strong><br />

                    <span id="txt-vip-body">Returning customer with high lead score.</span>

                </div>
            }

        </div>

    </div>

    <!-- RIGHT SIDE -->
    <div class="col-md-8">

        <div class="d-flex justify-content-between">
            <h5 id="txt-visit-details">Visit Details</h5>

            <button class="btn btn-outline-dark btn-sm"
                    onclick="enableEdit()">
                <i class="bi bi-pencil"></i> <span id="txt-edit-record">Edit Record</span>
            </button>
        </div>

        <hr />

        @if (ViewBag.Tab == "missed")
        {
            <!-- MISSED EDIT ONLY -->

            <form method="post" action="/Admins/Reports/UpdateMissed">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row g-3">

                    <div class="col-md-6">

                        <label id="txt-lbl-status">Status</label>

                        <select name="FollowUpStatus" class="form-select">

                            <option value="pending"
                                    selected="@(Model.FollowUpStatus == "pending")"
                                    class="opt-pending">
                                Pending
                            </option>

                            <option value="contacted"
                                    selected="@(Model.FollowUpStatus == "contacted")"
                                    class="opt-contacted">
                                Contacted
                            </option>

                            <option value="not_interested"
                                    selected="@(Model.FollowUpStatus == "not_interested")"
                                    class="opt-not-interested">
                                Not Interested
                            </option>

                        </select>
                    </div>

                    <div class="col-md-6">

                        <label id="txt-lbl-salesperson">Assigned Salesperson</label>

                        <select name="SalespersonId" class="form-select">

                            <option value="" class="opt-unassigned">Unassigned</option>

                            @foreach (var sp in ViewBag.Salespersons)
                            {
                                <option value="@sp.Id"
                                        selected="@(Model.SalespersonId == sp.Id)">
                                    @sp.Name
                                </option>
                            }

                        </select>
                    </div>

                    <div class="col-12">

                        <label id="txt-lbl-notes">Notes</label>

                        <textarea name="Notes"
                              class="form-control"
                              rows="5">@Model.Notes</textarea>

                    </div>

                </div>

                <div class="mt-3">
                    <button class="btn btn-dark" id="txt-save-btn">
                        Save Changes
                    </button>
                </div>

            </form>
        }
        else
        {
            <!-- DAILY EDIT ONLY -->

            <form method="post" action="/Admins/Reports/Details">

                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-fullname">Full Name</label>

                        <input name="Name"
                               value="@Model.Name"
                               class="form-control editable"
                               disabled />

                    </div>

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-phone">Phone</label>

                        <input name="Phone"
                               value="@Model.Phone"
                               class="form-control editable"
                               disabled />

                    </div>

                    <div class="col-md-12 mb-2">

                        <label id="txt-lbl-email">Email</label>

                        <input name="Email"
                               value="@Model.Email"
                               class="form-control editable"
                               disabled />

                    </div>

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-showroom">Showroom</label>

                        <select name="ShowroomId"
                                class="form-select editable"
                                disabled>

                            @foreach (var s in ViewBag.Showrooms)
                            {
                                <option value="@s.Id"
                                        selected="@(s.Id == Model.ShowroomId)">
                                    @s.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-product">Product</label>

                        <select name="ProductId"
                                class="form-select editable"
                                disabled>

                            <option value="" class="opt-select-product">
                                Select product
                            </option>

                            @foreach (var p in ViewBag.Products)
                            {
                                <option value="@p.Id"
                                        selected="@(p.Id == Model.ProductId)">
                                    @p.Name
                                </option>
                            }

                        </select>

                    </div>

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-followup">Follow-up Status</label>

                        <select name="FollowUpStatus"
                                class="form-select editable"
                                disabled>

                            <option value="pending"
                                    selected="@(Model.FollowUpStatus == "pending")"
                                    class="opt-pending">
                                Pending
                            </option>

                            <option value="contacted"
                                    selected="@(Model.FollowUpStatus == "contacted")"
                                    class="opt-contacted">
                                Contacted
                            </option>

                            <option value="not_interested"
                                    selected="@(Model.FollowUpStatus == "not_interested")"
                                    class="opt-not-interested">
                                Not Interested
                            </option>

                        </select>

                    </div>

                    <div class="col-md-6 mb-2">

                        <label id="txt-lbl-score">Lead Score</label>

                        <input name="Score"
                               value="@Model.Score"
                               type="number"
                               min="0"
                               max="100"
                               class="form-control editable"
                               disabled />

                        <small class="text-muted" id="txt-score-hint">
                            High: 70+, Medium: 40–69, Low: below 40
                        </small>

                    </div>

                    <!-- ADMIN NOTES TIMELINE -->
                    <div class="col-md-12 mb-2">

                        <label id="txt-lbl-notes">Notes</label>

                        <textarea name="Notes"
                              class="form-control editable"
                              rows="5"
                              placeholder="Example: 14 May 2026 - Called customer and sent quotation."
                              disabled>@Model.Notes</textarea>

                        <small class="text-muted" id="txt-notes-hint">

                            Admin Notes Timeline:
                            Add each follow-up as a new line.

                            Example:
                            14 May 2026 - Called customer and sent quotation.

                        </small>

                    </div>

                </div>

                <div class="mt-3 d-none" id="editButtons">

                    <button type="submit" class="btn btn-dark" id="txt-save-btn">
                        Save Changes
                    </button>

                    <a href="/Admins/Reports/Details/@Model.Id"
                       class="btn btn-light" id="txt-cancel-btn">
                        Cancel
                    </a>

                </div>

            </form>
        }

    </div>

</div>

@section Scripts
{
    <script>

        function enableEdit() {

            document.querySelectorAll('.editable').forEach(e => {
                e.removeAttribute('disabled');
            });

            const editButtons =
                document.getElementById('editButtons');

            if (editButtons) {
                editButtons.classList.remove('d-none');
            }
        }

    </script>

    <script>

        setTimeout(() => {

            let msg =
                document.getElementById("successMsg");

            if (msg) {

                msg.style.transition = "0.5s";
                msg.style.opacity = "0";

                setTimeout(() => msg.remove(), 500);
            }

        }, 2000);

    </script>

    <!-- ===== TRANSLATION SCRIPT ===== -->
    <script>
        const detailsTranslations = {
            en: {
                back:              "← Back to Reports",
                visitDetails:      "Visit Details",
                editRecord:        "Edit Record",
                leadScoreLabel:    "Lead Score",
                recommendationLabel: "Recommendation:",
                // Recommendation texts (by score)
                recHigh:           "Contact immediately and prioritize follow-up.",
                recMedium:         "Follow up within 24 hours.",
                recLow:            "Low-priority lead. Keep for future campaigns.",
                // VIP
                vipTitle:          "VIP Customer",
                vipBody:           "Returning customer with high lead score.",
                // Level labels
                levelHigh:         "High",
                levelMedium:       "Medium",
                levelLow:          "Low",
                // Form labels
                fullName:          "Full Name",
                phone:             "Phone",
                email:             "Email",
                showroom:          "Showroom",
                product:           "Product",
                followup:          "Follow-up Status",
                score:             "Lead Score",
                scoreHint:         "High: 70+, Medium: 40–69, Low: below 40",
                notes:             "Notes",
                notesHint:         "Admin Notes Timeline: Add each follow-up as a new line. Example: 14 May 2026 - Called customer and sent quotation.",
                status:            "Status",
                salesperson:       "Assigned Salesperson",
                // Options
                pending:           "Pending",
                contacted:         "Contacted",
                notInterested:     "Not Interested",
                unassigned:        "Unassigned",
                selectProduct:     "Select product",
                // Buttons
                saveChanges:       "Save Changes",
                cancel:            "Cancel"
            },
            ar: {
                back:              "→ العودة إلى التقارير",
                visitDetails:      "تفاصيل الزيارة",
                editRecord:        "تعديل السجل",
                leadScoreLabel:    "نقاط العميل",
                recommendationLabel: "التوصية:",
                // Recommendation texts
                recHigh:           "تواصل فوراً وأعطِ هذا العميل الأولوية.",
                recMedium:         "تابع خلال 24 ساعة.",
                recLow:            "عميل ذو أولوية منخفضة. احتفظ به للحملات المستقبلية.",
                // VIP
                vipTitle:          "عميل مميز VIP",
                vipBody:           "عميل عائد بنقاط عالية.",
                // Level labels
                levelHigh:         "مرتفع",
                levelMedium:       "متوسط",
                levelLow:          "منخفض",
                // Form labels
                fullName:          "الاسم الكامل",
                phone:             "الهاتف",
                email:             "البريد الإلكتروني",
                showroom:          "المعرض",
                product:           "المنتج",
                followup:          "حالة المتابعة",
                score:             "نقاط العميل",
                scoreHint:         "مرتفع: 70+، متوسط: 40–69، منخفض: أقل من 40",
                notes:             "ملاحظات",
                notesHint:         "سجل المتابعات: أضف كل متابعة في سطر جديد. مثال: 14 مايو 2026 - تم الاتصال بالعميل وإرسال عرض الأسعار.",
                status:            "الحالة",
                salesperson:       "مندوب المبيعات المعين",
                // Options
                pending:           "قيد الانتظار",
                contacted:         "تم التواصل",
                notInterested:     "غير مهتم",
                unassigned:        "غير معين",
                selectProduct:     "اختر المنتج",
                // Buttons
                saveChanges:       "حفظ التغييرات",
                cancel:            "إلغاء"
            }
        };

        function translateDetailsPage(lang) {
            const t = detailsTranslations[lang];
            if (!t) return;

            const set = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.innerText = val;
            };

            const setAll = (sel, val) => {
                document.querySelectorAll(sel).forEach(el => el.innerText = val);
            };

            // General
            set('txt-back',               t.back);
            set('txt-visit-details',      t.visitDetails);
            set('txt-edit-record',        t.editRecord);
            set('txt-lead-score-label',   t.leadScoreLabel);
            set('txt-recommendation-label', t.recommendationLabel);
            set('txt-recommendation-text',  t.recHigh || t.recMedium || t.recLow);
            set('txt-vip-title',          t.vipTitle);
            set('txt-vip-body',           t.vipBody);

            // Translate the level label inside the badge (High/Medium/Low)
            const levelEl = document.getElementById('txt-level');
            if (levelEl) {
                const txt = levelEl.innerText.trim();
                if (txt === 'High'   || txt === 'مرتفع') levelEl.innerText = t.levelHigh;
                if (txt === 'Medium' || txt === 'متوسط') levelEl.innerText = t.levelMedium;
                if (txt === 'Low'    || txt === 'منخفض') levelEl.innerText = t.levelLow;
            }

            // Recommendation text (one span exists depending on server-side score branch)
            const recEl = document.getElementById('txt-recommendation-text');
            if (recEl) {
                const raw = recEl.innerText.trim();
                if (raw.includes('immediately') || raw.includes('فوراً'))
                    recEl.innerText = t.recHigh;
                else if (raw.includes('24') )
                    recEl.innerText = t.recMedium;
                else
                    recEl.innerText = t.recLow;
            }

            // Form labels
            set('txt-lbl-status',      t.status);
            set('txt-lbl-salesperson', t.salesperson);
            set('txt-lbl-notes',       t.notes);
            set('txt-lbl-fullname',    t.fullName);
            set('txt-lbl-phone',       t.phone);
            set('txt-lbl-email',       t.email);
            set('txt-lbl-showroom',    t.showroom);
            set('txt-lbl-product',     t.product);
            set('txt-lbl-followup',    t.followup);
            set('txt-lbl-score',       t.score);
            set('txt-score-hint',      t.scoreHint);
            set('txt-notes-hint',      t.notesHint);

            // Dropdown options (by class)
            setAll('.opt-pending',        t.pending);
            setAll('.opt-contacted',      t.contacted);
            setAll('.opt-not-interested', t.notInterested);
            setAll('.opt-unassigned',     t.unassigned);
            setAll('.opt-select-product', t.selectProduct);

            // Buttons
            set('txt-save-btn',   t.saveChanges);
            set('txt-cancel-btn', t.cancel);
        }

        // Apply on page load
        window.addEventListener('load', function () {
            setTimeout(function () {
                const lang = localStorage.getItem('siteLang') || 'en';
                translateDetailsPage(lang);
            }, 200);
        });

        // Listen for language toggle from layout buttons
        window.addEventListener('languageChanged', function (e) {
            translateDetailsPage(e.detail);
        });
    </script>
}