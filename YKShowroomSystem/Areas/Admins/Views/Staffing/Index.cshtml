        /* ─────────────────────────────────────────────────────────────
           Main translate function
        ───────────────────────────────────────────────────────────── */
        function translateStaffPage(lang) {
            const t = smTranslations[lang] || smTranslations['en'];

            /* Helper: set innerText safely */
            const set = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.innerText = val;
            };

            /* ── IDs ── */
            set('sm-txt-page-title',           t.pageTitle);
            set('sm-txt-section-overview',     t.sectionOverview);
            set('sm-txt-section-showroom',     t.sectionShowroom);
            set('sm-txt-section-salesperson',  t.sectionSalesperson);
            set('sm-txt-section-reserve',      t.sectionReserve);
            set('sm-txt-active-showrooms',     t.activeShowrooms);
            set('sm-txt-overdue-followups',    t.overdueFollowups);
            set('sm-txt-busiest-showroom',     t.busiestShowroom);
            set('sm-txt-reserve-now',          t.reserveNow);

            /* ── "X visits" label beside busiest showroom count ── */
            const visitsEl = document.getElementById('sm-txt-visits-count');
            if (visitsEl) {
                const count = visitsEl.getAttribute('data-count');
                visitsEl.innerText = count + ' ' + t.visitsWord;
            }

            /* ── All generic data-key elements (class sm-t) ── */
            document.querySelectorAll('.sm-t[data-key]').forEach(el => {
                const key = el.getAttribute('data-key');
                if (t[key] !== undefined) {
                    /* legendOverdueDesc contains <strong> tags — use innerHTML */
                    if (key === 'legendOverdueDesc') {
                        el.innerHTML = t[key];
                    } else {
                        el.innerText = t[key];
                    }
                }
            });

            /* ── Status pills on showroom cards ── */
            document.querySelectorAll('.sm-status-pill[data-status-key]').forEach(el => {
                const key = el.getAttribute('data-status-key');
                if (t[key]) el.innerText = t[key];
            });

            /* ── Load level pills in salesperson table ── */
            document.querySelectorAll('.sm-load-pill[data-load-key]').forEach(el => {
                const key = el.getAttribute('data-load-key');
                if (t[key]) el.innerText = t[key];
            });

            /* ── "X overdue" cells in salesperson table ── */
            document.querySelectorAll('.sm-overdue-cell[data-count]').forEach(el => {
                const count = el.getAttribute('data-count');
                el.innerText = count + ' ' + t.overdueWord;
            });

            /* ── Shift labels on reserve staff cards ── */
            document.querySelectorAll('.sm-shift-label').forEach(el => {
                el.innerText = lang === 'ar' ? el.getAttribute('data-ar') : el.getAttribute('data-en');
            });

            /* ── "X people available right now" banner ── */
            const bannerEl = document.getElementById('sm-txt-reserve-banner');
            if (bannerEl) {
                const count = parseInt(bannerEl.getAttribute('data-count'));
                const personWord = count === 1 ? t.personSingular : t.personPlural;
                bannerEl.innerText = count + ' ' + personWord + ' ' + t.availableRightNow;
            }

            /* ── Recommendation paragraphs — show EN or AR version from controller ── */
            document.querySelectorAll('.sm-rec-en').forEach(el => {
                el.style.display = lang === 'ar' ? 'none' : '';
            });
            document.querySelectorAll('.sm-rec-ar').forEach(el => {
                el.style.display = lang === 'ar' ? '' : 'none';
            });
        }

        /* ─────────────────────────────────────────────────────────────
           Hooks — same pattern as Dashboard page
           1. window load + small delay (lets the layout finish first)
           2. languageChanged event fired by the layout's setLanguage()
        ───────────────────────────────────────────────────────────── */
        window.addEventListener('load', function () {
            setTimeout(function () {
                const lang = localStorage.getItem('siteLang') || 'en';
                translateStaffPage(lang);
            }, 200);
        });

        window.addEventListener('languageChanged', function (e) {
            translateStaffPage(e.detail);
        });
    </script>
