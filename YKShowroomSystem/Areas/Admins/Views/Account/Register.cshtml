@model YKShowroomSystem.Areas.Admins.Models.RegisterViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html id="pageHtml">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Register</title>

    <style>
        /* ── LOGO ─────────────────────────────────────────── */
        .logo {
            width: 40px;
            height: 40px;
            border: 3px solid #0b1b3f;
            border-radius: 50%;
            position: relative;
        }

            .logo::after {
                content: "";
                width: 10px;
                height: 10px;
                background: gold;
                border-radius: 50%;
                position: absolute;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
            }

        /* ── THEME SWITCH ─────────────────────────────────── */
        .theme-switch {
            position: relative;
            display: inline-block;
            width: 56px;
            height: 28px;
            cursor: pointer;
        }

            .theme-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .slider {
            position: absolute;
            inset: 0;
            background: #ccc;
            border-radius: 34px;
            transition: background 0.3s;
            display: flex;
            align-items: center;
            padding: 0 4px;
        }

        .theme-switch input:checked + .slider {
            background: #444;
        }

        .icon {
            font-size: 16px;
            transition: transform 0.3s;
            user-select: none;
        }

        /* ── DARK MODE OVERRIDES ──────────────────────────── */
        body.dark-mode {
            background: #121212 !important;
        }

            body.dark-mode .page-bg {
                background: #121212 !important;
            }

            body.dark-mode .card {
                background: #1e1e1e !important;
                color: #f0f0f0 !important;
            }

            body.dark-mode .form-control {
                background: #2a2a2a !important;
                color: #f0f0f0 !important;
                border-color: #555 !important;
            }

                body.dark-mode .form-control::placeholder {
                    color: #aaa !important;
                }

            body.dark-mode .text-muted {
                color: #aaa !important;
            }

            body.dark-mode a {
                color: gold;
            }
    </style>
</head>
<body>

    <!-- Language Button -->
    <div style="position:fixed; top:20px; right:20px; z-index:9999;">
        <button onclick="toggleLanguage()" id="langBtn"
                style="background:white; border:2px solid #ccc; border-radius:25px;
                       padding:8px 18px; font-size:14px; font-weight:bold;
                       cursor:pointer; display:flex; align-items:center; gap:8px;
                       box-shadow:0 2px 8px rgba(0,0,0,0.2); color:#0b1b3f;">
            🌐 English
        </button>
    </div>

    <!-- Dark/Light Mode Toggle -->
    <div style="position:fixed; top:20px; left:20px; z-index:9999;">
        <label class="theme-switch" title="Toggle Dark/Light Mode">
            <input type="checkbox" id="themeToggle" onchange="toggleTheme()" />
            <span class="slider">
                <span class="icon" id="themeIcon">☀️</span>
            </span>
        </label>
    </div>

    <!-- Page Wrapper -->
    <div class="page-bg d-flex justify-content-center align-items-center vh-100" style="background:#0b1b3f;">
        <div class="card p-4 shadow-sm" style="width:400px; border-radius:15px;">
            <!-- HEADER -->
            <div class="text-center mb-3">
                <div class="logo mx-auto mb-2"></div>
                <h4 class="fw-bold" id="txt-title">Create Account</h4>
                <p class="text-muted" id="txt-subtitle">Join the Showroom Portal</p>
            </div>

            <form method="post">
                <!-- Name -->
                <div class="mb-2">
                    <input asp-for="Name" class="form-control" id="txt-name-input" placeholder="Full Name" />
                    <span asp-validation-for="Name" class="text-danger small" id="txt-name-error"></span>
                </div>
                <!-- Email -->
                <div class="mb-2">
                    <input asp-for="Email" class="form-control" id="txt-email-input" placeholder="Email" />
                    <span asp-validation-for="Email" class="text-danger small" id="txt-email-error"></span>
                </div>
                <!-- Password -->
                <div class="mb-2">
                    <input asp-for="Password" type="password" class="form-control" id="txt-password-input" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small" id="txt-password-error"></span>
                </div>
                <!-- Server-side Error -->
                @if (ViewBag.Error != null)
                {
                    <div class="text-danger mb-2">@ViewBag.Error</div>
                }
                <!-- Submit Button -->
                <button type="submit" class="btn w-100 mt-2" id="txt-register-btn" style="background:gold;">
                    Register
                </button>
            </form>

            <!-- FOOTER -->
            <p class="text-center mt-3" id="txt-signin-p">
                <span id="txt-signin-label">Already have an account?</span>
                <a href="/Admins/Account/Login" id="txt-signin-link">Sign in</a>
            </p>
        </div>
    </div>

    <!--Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // ── LANGUAGE ───────────────────────────────────────
        let currentLang = localStorage.getItem('lang') || 'en';

        const translations = {
            en: {
                title: "Create Account",
                subtitle: "Join the Showroom Portal",
                namePlaceholder: "Full Name",
                emailPlaceholder: "Email",
                passwordPlaceholder: "Password",
                registerBtn: "Register",
                signinLabel: "Already have an account?",
                signinLink: "Sign in",
                langBtn: "🌐 English"
            },
            ar: {
                title: "إنشاء حساب",
                subtitle: "انضم إلى بوابة الصالة",
                namePlaceholder: "الاسم الكامل",
                emailPlaceholder: "البريد الإلكتروني",
                passwordPlaceholder: "كلمة المرور",
                registerBtn: "تسجيل",
                signinLabel: "لديك حساب بالفعل؟",
                signinLink: "تسجيل الدخول",
                langBtn: "🌐 عربي"
            }
        };

        const errorMap = {
            'The Name field is required.': 'الاسم مطلوب.',
            'The Email field is required.': 'البريد الإلكتروني مطلوب.',
            'The Password field is required.': 'كلمة المرور مطلوبة.',
            'Name is required': 'الاسم مطلوب.',
            'Email is required': 'البريد الإلكتروني مطلوب.',
            'Password is required': 'كلمة المرور مطلوبة.',
            'The Email field is not a valid e-mail address.': 'البريد الإلكتروني غير صحيح.',
            'Invalid email address.': 'عنوان البريد الإلكتروني غير صالح.',
            'Email already exists.': 'البريد الإلكتروني مستخدم بالفعل.',
            'This email is already registered': 'هذا البريد الإلكتروني مسجّل بالفعل.',
            'Password must be at least 8 characters': 'يجب أن تكون كلمة المرور 8 أحرف على الأقل.',
            'Password must contain at least one capital letter': 'يجب أن تحتوي كلمة المرور على حرف كبير واحد على الأقل.'
        };

        function translatePage(lang) {
            const t = translations[lang];
            document.getElementById('txt-title').innerText        = t.title;
            document.getElementById('txt-subtitle').innerText     = t.subtitle;
            document.getElementById('txt-name-input').placeholder = t.namePlaceholder;
            document.getElementById('txt-email-input').placeholder = t.emailPlaceholder;
            document.getElementById('txt-password-input').placeholder = t.passwordPlaceholder;
            document.getElementById('txt-register-btn').innerText = t.registerBtn;
            document.getElementById('txt-signin-label').innerText = t.signinLabel;
            document.getElementById('txt-signin-link').innerText  = t.signinLink;
            document.getElementById('langBtn').innerText          = t.langBtn;
            document.getElementById('pageHtml').dir = lang === 'ar' ? 'rtl' : 'ltr';
            translateVisibleErrors();
        }

        function translateVisibleErrors() {
            if (currentLang !== 'ar') return;
            document.querySelectorAll('span[data-valmsg-for], .text-danger').forEach(function (el) {
                const original = el.innerText.trim();
                if (errorMap[original]) el.innerText = errorMap[original];
            });
        }

        function toggleLanguage() {
            currentLang = currentLang === 'en' ? 'ar' : 'en';
            localStorage.setItem('lang', currentLang);
            translatePage(currentLang);
        }

        function observeValidationErrors() {
            var observer = new MutationObserver(function (mutations) {
                if (currentLang !== 'ar') return;
                mutations.forEach(function (mutation) {
                    mutation.addedNodes.forEach(function (node) {
                        if (node.nodeType === Node.TEXT_NODE) {
                            var text = node.textContent.trim();
                            if (errorMap[text]) node.textContent = errorMap[text];
                        }
                        if (node.nodeType === Node.ELEMENT_NODE) {
                            var text = node.innerText.trim();
                            if (errorMap[text]) node.innerText = errorMap[text];
                        }
                    });
                    if (mutation.type === 'characterData') {
                        var text = mutation.target.textContent.trim();
                        if (errorMap[text]) mutation.target.textContent = errorMap[text];
                    }
                });
            });

            observer.observe(document.body, {
                childList: true,
                subtree: true,
                characterData: true
            });
        }

        // ── DARK / LIGHT MODE ──────────────────────────────
        function toggleTheme() {
            const isDark = document.getElementById('themeToggle').checked;
            document.body.classList.toggle('dark-mode', isDark);
            document.getElementById('themeIcon').innerText = isDark ? '🌙' : '☀️';

            // Swap page background colour
            const pageBg = document.querySelector('.page-bg');
            if (pageBg) {
                pageBg.style.background = isDark ? '#1a1a2e' : '#0b1b3f';
            }

            localStorage.setItem('theme', isDark ? 'dark' : 'light');
        }

        function applyStoredTheme() {
            const stored = localStorage.getItem('theme');
            if (stored === 'dark') {
                document.getElementById('themeToggle').checked = true;
                toggleTheme();
            }
        }

        // ── ON LOAD ────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            applyStoredTheme();
            translatePage(currentLang);
            observeValidationErrors();
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }
</body>
</html>