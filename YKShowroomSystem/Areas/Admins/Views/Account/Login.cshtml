@model YKShowroomSystem.Areas.Admins.Models.LoginViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html id="pageHtml" dir="ltr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <title>Login</title>
</head>

<body>

    <!-- Translation Button -->
    <div style="position:fixed; top:20px; right:20px; z-index:9999;">
        <button onclick="toggleLanguage()" id="langBtn"
                style="background:white; border:2px solid #ccc; border-radius:25px;
            padding:8px 18px; font-size:14px; font-weight:bold;
            cursor:pointer; display:flex; align-items:center; gap:8px;
            box-shadow:0 2px 8px rgba(0,0,0,0.2); color:#0b1b3f;">
            🌐 English
        </button>
    </div>

    <!-- Dark/Light Mode Toggle -->
    <div style="position:fixed; top:20px; left:20px; z-index:9999;">
        <label class="theme-switch" title="Toggle Dark/Light Mode">
            <input type="checkbox" id="themeToggle" onchange="toggleTheme()" />
            <span class="slider">
                <span class="icon" id="themeIcon">☀️</span>
            </span>
        </label>
    </div>

    <div class="d-flex justify-content-center align-items-center vh-100" id="pageBody" style="background:#0b1b3f;">

        <div class="card p-4 shadow-sm" id="loginCard" style="width:400px; border-radius:15px;">

            <!-- HEADER -->
            <div class="text-center mb-3">
                <div class="logo mx-auto mb-2" id="logoBadge"></div>
                <h4 class="fw-bold" id="txt-title">Showroom Portal</h4>
                <p class="text-muted" id="txt-subtitle">Sign in to manage showrooms</p>
            </div>

            <form method="post">

                <div class="mb-2">
                    <input asp-for="Email" class="form-control login-input" id="txt-email-input"
                           placeholder="admin@example.com" />
                    <span asp-validation-for="Email" class="text-danger small" id="txt-email-error"></span>
                </div>

                <div class="mb-2">
                    <input asp-for="Password" type="password" class="form-control login-input"
                           id="txt-password-input" placeholder="Password" />
                    <span asp-validation-for="Password" class="text-danger small" id="txt-password-error"></span>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="text-danger mb-2">@ViewBag.Error</div>
                }

                <button type="submit" class="btn w-100 mt-2" style="background:gold; color:#0b1b3f; font-weight:bold;" id="txt-signin-btn">
                    Sign In
                </button>

            </form>

            <p class="text-center mt-3" id="txt-register-p">
                <span id="txt-register-label">Need an account?</span>
                <a href="/Admins/Account/Register" id="txt-register-link">Register</a>
            </p>

        </div>

    </div>

    <!-- BOOTSTRAP JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* ── Toggle Switch ── */
        .theme-switch {
        position: relative;
        display: inline-block;
        width: 62px;
        height: 32px;
        cursor: pointer;
        }

        .theme-switch input {
        opacity: 0;
        width: 0;
        height: 0;
        }

        .slider {
        position: absolute;
        inset: 0;
        background: #ccc;
        border-radius: 34px;
        transition: background 0.3s;
        display: flex;
        align-items: center;
        }

        .theme-switch input:checked + .slider {
        background: #4f6ef7;
        }

        .icon {
        position: absolute;
        left: 4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        transition: transform 0.3s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.3);
        }

        .theme-switch input:checked + .slider .icon {
        transform: translateX(30px);
        }

        /* ── Logo ── */
        .logo {
        width: 40px;
        height: 40px;
        border: 3px solid #0b1b3f;
        border-radius: 50%;
        position: relative;
        }

        .logo::after {
        content: "";
        width: 10px;
        height: 10px;
        background: gold;
        border-radius: 50%;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        }

        /* ── LIGHT MODE (default) ── */
        body.light-mode #pageBody {
        background: #0b1b3f !important;
        }

        body.light-mode #loginCard {
        background: #ffffff;
        color: #0b1b3f;
        }

        body.light-mode #txt-title {
        color: #0b1b3f;
        }

        body.light-mode #txt-subtitle {
        color: #6c757d;
        }

        body.light-mode .login-input {
        background: #ffffff;
        color: #0b1b3f;
        border-color: #ced4da;
        }

        body.light-mode .login-input::placeholder {
        color: #aaa;
        }

        body.light-mode #txt-register-p {
        color: #0b1b3f;
        }

        body.light-mode #langBtn {
        background: white;
        color: #0b1b3f;
        border-color: #ccc;
        }

        body.light-mode #logoBadge {
        border-color: #0b1b3f;
        }

        /* ── DARK MODE ── */
        body.dark-mode #pageBody {
        background: #0a0a0a !important;
        }

        body.dark-mode #loginCard {
        background: #1e1e2e;
        color: #e0e0e0;
        border: 1px solid #333;
        }

        body.dark-mode #txt-title {
        color: #f0f0f0;
        }

        body.dark-mode #txt-subtitle {
        color: #cccccc !important;
        }

        body.dark-mode .login-input {
        background: #2a2a3d;
        color: #f0f0f0;
        border-color: #444;
        }

        body.dark-mode .login-input::placeholder {
        color: #777;
        }

        body.dark-mode #txt-register-p {
        color: #cccccc;
        }

        body.dark-mode #txt-register-link {
        color: #7eb3ff;
        }

        body.dark-mode #langBtn {
        background: #2a2a3d;
        color: #f0f0f0;
        border-color: #555;
        }

        body.dark-mode #logoBadge {
        border-color: #f0f0f0;
        }
    </style>

    <script>
        // ── THEME ──────────────────────────────────────────
        let currentTheme = localStorage.getItem('theme') || 'light';

        function applyTheme(theme) {
        const icon = document.getElementById('themeIcon');
        const toggle = document.getElementById('themeToggle');

        if (theme === 'dark') {
        document.body.classList.remove('light-mode');
        document.body.classList.add('dark-mode');
        icon.innerText = '🌙';
        toggle.checked = true;
        } else {
        document.body.classList.remove('dark-mode');
        document.body.classList.add('light-mode');
        icon.innerText = '☀️';
        toggle.checked = false;
        }
        }

        function toggleTheme() {
        currentTheme = currentTheme === 'light' ? 'dark' : 'light';
        localStorage.setItem('theme', currentTheme);
        applyTheme(currentTheme);
        }

        // ── LANGUAGE ───────────────────────────────────────
        let currentLang = localStorage.getItem('lang') || 'en';

        const translations = {
        en: {
        title: "Showroom Portal",
        subtitle: "Sign in to manage showrooms",
        emailPlaceholder: "admin@example.com",
        passwordPlaceholder: "Password",
        signinBtn: "Sign In",
        registerLabel: "Need an account?",
        registerLink: "Register",
        langBtn: "🌐 English"
        },
        ar: {
        title: "بوابة الصالة",
        subtitle: "سجّل دخولك لإدارة الصالات",
        emailPlaceholder: "admin@example.com",
        passwordPlaceholder: "كلمة المرور",
        signinBtn: "تسجيل الدخول",
        registerLabel: "ليس لديك حساب؟",
        registerLink: "إنشاء حساب",
        langBtn: "🌐 العربية"
        }
        };

        const errorMap = {
        'The Email field is required.': 'البريد الإلكتروني مطلوب.',
        'The Password field is required.': 'كلمة المرور مطلوبة.',
        'Email is required': 'البريد الإلكتروني مطلوب.',
        'Password is required': 'كلمة المرور مطلوبة.',
        'The Email field is not a valid e-mail address.': 'البريد الإلكتروني غير صحيح.',
        'Invalid email address.': 'عنوان البريد الإلكتروني غير صالح.',
        'Invalid login attempt.': 'محاولة تسجيل دخول غير صحيحة.',
        'Invalid credentials.': 'بيانات الدخول غير صحيحة.',
        'User not found.': 'المستخدم غير موجود.',
        'Incorrect password.': 'كلمة المرور غير صحيحة.'
        };

        function translatePage(lang) {
        const t = translations[lang];
        document.getElementById('txt-title').innerText = t.title;
        document.getElementById('txt-subtitle').innerText = t.subtitle;
        document.getElementById('txt-email-input').placeholder = t.emailPlaceholder;
        document.getElementById('txt-password-input').placeholder = t.passwordPlaceholder;
        document.getElementById('txt-signin-btn').innerText = t.signinBtn;
        document.getElementById('txt-register-label').innerText = t.registerLabel;
        document.getElementById('txt-register-link').innerText = t.registerLink;
        document.getElementById('langBtn').innerHTML = t.langBtn;
        document.getElementById('pageHtml').dir = lang === 'ar' ? 'rtl' : 'ltr';
        translateVisibleErrors();
        }

        function translateVisibleErrors() {
        if (currentLang !== 'ar') return;
        document.querySelectorAll('span[data-valmsg-for], .text-danger').forEach(function (el) {
        const original = el.innerText.trim();
        if (errorMap[original]) el.innerText = errorMap[original];
        });
        }

        function toggleLanguage() {
        currentLang = currentLang === 'en' ? 'ar' : 'en';
        localStorage.setItem('lang', currentLang);
        translatePage(currentLang);
        }

        function observeValidationErrors() {
        var observer = new MutationObserver(function (mutations) {
        if (currentLang !== 'ar') return;
        mutations.forEach(function (mutation) {
        mutation.addedNodes.forEach(function (node) {
        if (node.nodeType === Node.TEXT_NODE) {
        var text = node.textContent.trim();
        if (errorMap[text]) node.textContent = errorMap[text];
        }
        if (node.nodeType === Node.ELEMENT_NODE) {
        var text = node.innerText.trim();
        if (errorMap[text]) node.innerText = errorMap[text];
        }
        });
        if (mutation.type === 'characterData') {
        var text = mutation.target.textContent.trim();
        if (errorMap[text]) mutation.target.textContent = errorMap[text];
        }
        });
        });

        observer.observe(document.body, {
        childList: true,
        subtree: true,
        characterData: true
        });
        }

        // ── ON LOAD ────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
        applyTheme(currentTheme);
        translatePage(currentLang);
        observeValidationErrors();
        });
    </script>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }

</body>
</html>