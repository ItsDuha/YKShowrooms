@{
    Layout = "~/Areas/Admins/Views/Shared/_Layout.cshtml";
}

<h5 id="txt-page-title">Dashboard</h5>
<div class="d-flex justify-content-end mb-4">

    <form method="get">

        <select name="showroomId" class="showroom-filter" onchange="this.form.submit()">

            <option value="0" id="txt-all-showrooms">All Showrooms</option>

            @foreach (var s in ViewBag.Showrooms)
            {
                if (ViewBag.SelectedShowroom == s.Id)
                {
                    <option value="@s.Id" selected>@s.Name</option>
                }
                else
                {
                    <option value="@s.Id">@s.Name</option>
                }
            }

        </select>

    </form>

</div>

<div class="row mb-4">

    <!-- TODAY -->
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <small id="txt-today-walkins">Today's Walk-ins</small>
            <h2>@ViewBag.TodayCount</h2>
            <small class="text-muted" id="txt-customers-today">Customers checked in today</small>
        </div>
    </div>

    <!-- WEEK -->
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <small id="txt-this-week">This Week</small>
            <h2>@ViewBag.WeekCount</h2>
            <small class="text-muted" id="txt-since-week">Since start of this week</small>
        </div>
    </div>

    <!-- AVG SCORE -->
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <small id="txt-avg-score">Avg Lead Score</small>
            <h2>@ViewBag.AvgScore <small>/100</small></h2>
            <small class="text-muted" id="txt-across-all">Across all visitors</small>
        </div>
    </div>

    <!-- MONTH -->
    <!-- MONTH -->
    <div class="col-md-3">
        <div class="card p-3 shadow-sm">
            <small id="txt-this-month">This Month</small>
            <h2>@ViewBag.MonthCount</h2>
            <small class="text-muted" id="txt-since-month">Since 1st of this month</small>
        </div>
    </div>

</div>

@if (true)
{
    <div class="alert alert-danger shadow-sm mb-4">
        <strong id="txt-urgent-alert">Urgent Alert:</strong>
        @ViewBag.MissedHighLeads <span id="txt-missed-leads">high-priority lead(s) still have pending follow-up.</span>
    </div>
}

<div class="card p-3 mb-4 shadow-sm">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <strong id="txt-lead-quality">Lead Quality Summary</strong><br />
            <small class="text-muted" id="txt-lead-quality-desc">Helps staff prioritize customers based on lead score</small>
        </div>
        <span class="badge bg-dark">
            @ViewBag.HighLeadRate% <span id="txt-high-leads-badge">High Leads</span>
        </span>
    </div>
    <div class="row text-center">
        <div class="col-md-3">
            <div class="p-3 rounded" style="background:#d4edda;">
                <h3 class="mb-0">@ViewBag.HighLeads</h3>
                <small class="fw-semibold text-success" id="txt-high-leads">High Leads</small><br />
                <small class="text-muted" id="txt-contact-first">Contact first</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 rounded" style="background:#fff3cd;">
                <h3 class="mb-0">@ViewBag.MediumLeads</h3>
                <small class="fw-semibold text-warning" id="txt-medium-leads">Medium Leads</small><br />
                <small class="text-muted" id="txt-follow-up-later">Follow up later</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 rounded" style="background:#e9ecef;">
                <h3 class="mb-0">@ViewBag.LowLeads</h3>
                <small class="fw-semibold text-secondary" id="txt-low-leads">Low Leads</small><br />
                <small class="text-muted" id="txt-low-priority">Low priority</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="p-3 rounded" style="background:#fff8dc;">
                <h3 class="mb-0 text-warning">@ViewBag.VipCustomers</h3>
                <small class="fw-semibold text-warning" id="txt-vip-customers">VIP Customers</small><br />
                <small class="text-muted" id="txt-returning-high">Returning + high score</small>
            </div>
        </div>
    </div>
    <div class="alert alert-light border mt-3 mb-0">
        <strong id="txt-business-insight">Business Insight:</strong> @ViewBag.PriorityMessage
    </div>
</div>

<div class="card p-4 shadow-sm mb-4">
    <h5 class="fw-bold mb-3" id="txt-business-insights">Business Insights</h5>
    <ul class="mb-0">
        <li>
            <span id="txt-high-lead-rate-prefix">High leads represent</span>
            <strong>@ViewBag.HighLeadRate%</strong>
            <span id="txt-high-lead-rate-suffix">of all scored visitors.</span>
        </li>
        <li>
            <span id="txt-most-requested">Most requested category:</span>
            <strong>@ViewBag.TopCategory</strong>
        </li>
        <li>
            <span id="txt-returning-customers">Returning customers:</span>
            <strong>@ViewBag.ReturningVisitors</strong>
        </li>
        <li>
            <span id="txt-vip-count">VIP customers:</span>
            <strong>@ViewBag.VipCustomers</strong>
        </li>
        <li>
            <span id="txt-pending-high">Pending high-priority leads:</span>
            <strong>@ViewBag.MissedHighLeads</strong>
        </li>
    </ul>
</div>

<div class="card p-3 mb-4 shadow-sm">

    <div class="d-flex justify-content-between mb-2">
        <div>
            <strong id="txt-walk-trends">Walk-in Trends</strong><br />
            <small class="text-muted" id="txt-last30">Last 30 days — from customer check-in records</small>
        </div>

        <select id="trendMode" class="form-select w-auto">
            <option value="day" id="txt-by-day">By Day</option>
            <option value="hour" id="txt-by-hour">By Hour</option>
        </select>
    </div>

    <canvas id="trendChart" height="100"></canvas>

</div>


<div class="card p-3 mb-4 shadow-sm">

    <div class="mb-2">
        <strong id="txt-leads-car">Leads by Car Model</strong><br />
        <small class="text-muted" id="txt-popular-cars">Most popular car models based on visitor interest</small>
    </div>

    <canvas id="modelChart" height="120"></canvas>

</div>
<div class="card p-3 shadow-sm mb-4">

    <strong id="txt-top-salespersons">Top Salespersons</strong>
    <small class="text-muted d-block mb-2" id="txt-based-on-high-leads">Based on high-priority leads</small>

    <canvas id="salesChart" height="120"></canvas>

</div>

<div class="card p-3 shadow-sm mb-4">

    <strong id="txt-follow-up">Follow-up Status</strong>

    <div class="chart-container">
        <canvas id="statusChart"></canvas>
    </div>

</div>

<div class="card p-3 shadow-sm">
    <strong id="txt-visitor-type">Visitor Type</strong>
    <div class="chart-container">
        <canvas id="visitorChart"></canvas>
    </div>
</div>

<!-- ── MARKETING PREVIEW ── -->
<div class="card p-4 shadow-sm mb-4 mt-4">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div>
            <p class="fw-semibold mb-0" style="font-size:15px;" id="txt-channel-title"> Visitor Growth by Channel</p>
        </div>
        <a href="/Admins/Marketing/Index" class="btn btn-dark btn-sm" id="txt-channel-btn">
            View Full Report →
        </a>
    </div>
    <div style="position:relative;height:220px;">
        <canvas id="dashMiniLineChart"></canvas>
    </div>
</div>

<div class="card shadow-sm" style="
    border-radius:16px;
    border:1.5px solid #e8ecf2;
    padding:28px 30px 32px;
    font-family:'DM Sans',sans-serif;">

    <!-- Header -->
    <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;margin-bottom:20px;">
        <div>
            <div style="font-family:'Syne',sans-serif;font-size:1.15rem;font-weight:700;color:#1a1f2e;" id="txt-peak-hours">
                Peak Hours
            </div>
            <div style="font-size:.82rem;color:#5a6175;margin-top:4px;" id="phSubText">
                <span id="txt-walk-volume">Walk-in volume by hour — all time</span>
            </div>
        </div>
        <!-- Day label -->
        <!-- Slot label -->

        <div style="display:flex;align-items:center;gap:12px;flex-wrap:wrap;">
            <span id="phBadge" style="
                background:#fff7e6;border:1.5px solid #fde8a8;
                color:#92400e;font-size:.76rem;font-weight:700;
                padding:6px 14px;border-radius:20px;white-space:nowrap;">
                — Busiest Hour
            </span>

        </div>
    </div>

    <!-- Day chips row -->
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:16px;">
        <span style="font-size:.72rem;font-weight:700;color:#9ca3af;letter-spacing:1px;text-transform:uppercase;margin-right:4px;direction:ltr;display:inline-block;" id="txt-day-label">Day:</span>


        <button onclick="phSetDay('All',this)" class="ph-day-chip ph-day-active">All</button>
        <button onclick="phSetDay('Monday',this)" class="ph-day-chip">Mon</button>
        <button onclick="phSetDay('Tuesday',this)" class="ph-day-chip">Tue</button>
        <button onclick="phSetDay('Wednesday',this)" class="ph-day-chip">Wed</button>
        <button onclick="phSetDay('Thursday',this)" class="ph-day-chip">Thu</button>
        <button onclick="phSetDay('Friday',this)" class="ph-day-chip">Fri</button>
        <button onclick="phSetDay('Saturday',this)" class="ph-day-chip">Sat</button>
        <button onclick="phSetDay('Sunday',this)" class="ph-day-chip">Sun</button>
        <input type="date" id="phDatePicker" onchange="phOnDatePick(this.value)"
               style="padding:6px 12px;border-radius:10px;border:1.5px solid #e8ecf2;
                      font-size:.78rem;color:#1a1f2e;background:#f8fafc;cursor:pointer;
                      font-family:'DM Sans',sans-serif;" />
    </div>

    <hr style="border:none;border-top:1.5px solid #e8ecf2;margin:0 0 16px;" />

    <!-- Slot filter row -->
    <div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:20px;">
        <span style="font-size:.72rem;font-weight:700;color:#9ca3af;letter-spacing:1px;text-transform:uppercase;direction:ltr;display:inline-block;" id="txt-slot-label">Slot:</span>

        <div id="phSlotChips" style="display:flex;gap:8px;flex-wrap:wrap;"></div>
    </div>

    <!-- VIEW A: Hourly column chart -->
    <div id="phViewChart">
        <div style="position:relative;padding-left:36px;">
            <div id="phYAxis" style="position:absolute;left:0;top:0;bottom:28px;display:flex;flex-direction:column;justify-content:space-between;"></div>
            <div style="position:relative;height:220px;border-bottom:2px solid #e8ecf2;">
                <div id="phGridLines" style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:space-between;pointer-events:none;"></div>
                <div id="phColsRow" style="position:absolute;inset:0;display:flex;align-items:flex-end;gap:6px;padding:0 4px;"></div>
            </div>
            <div id="phXRow" style="display:flex;gap:6px;padding:0 4px;margin-top:8px;"></div>
        </div>
    </div>

    <!-- VIEW B: Ranked bars -->
    <div id="phViewRanked" style="display:none;flex-direction:column;gap:10px;"></div>

    <!-- No data -->
    <div id="phNoData" style="display:none;text-align:center;padding:40px;color:#9ca3af;font-size:.9rem;">
        No walk-in data for this selection.
    </div>

    <!-- Footer -->
    <div style="margin-top:24px;padding-top:18px;border-top:1.5px solid #e8ecf2;
            display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:7px;font-size:.78rem;color:#5a6175;">
            <span style="width:8px;height:8px;border-radius:50%;background:#27ae60;
                     box-shadow:0 0 0 3px rgba(39,174,96,.15);flex-shrink:0;display:inline-block;"></span>
            <span id="txt-last-update-label">Last updated:</span>
            <strong id="phLastUpdated" style="color:#1a1f2e;font-weight:600;"></strong>
        </div>
        <div style="font-size:.72rem;color:#9ca3af;">
            · <span id="txt-filtered">filtered by selected showroom</span>
        </div>
    </div>

</div>

<style>
    .ph-day-chip {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: .78rem;
        font-weight: 500;
        border: 1.5px solid #e8ecf2;
        background: #f8fafc;
        color: #5a6175;
        cursor: pointer;
        transition: all .18s;
        font-family: 'DM Sans',sans-serif;
    }

        .ph-day-chip:hover {
            border-color: #f5a623;
            color: #f5a623;
            background: #fff7e6;
        }

    .ph-day-active {
        background: #1a1f2e !important;
        border-color: #1a1f2e !important;
        color: #fff !important;
        font-weight: 600 !important;
    }

    .ph-slot-chip {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: .74rem;
        font-weight: 500;
        border: 1.5px solid #e8ecf2;
        background: #f8fafc;
        color: #5a6175;
        cursor: pointer;
        transition: all .18s;
        font-family: 'DM Sans',sans-serif;
    }

        .ph-slot-chip:hover {
            border-color: #4a90d9;
            color: #4a90d9;
        }

    .ph-slot-chip-active {
        background: #4a90d9 !important;
        border-color: #4a90d9 !important;
        color: #fff !important;
        font-weight: 600 !important;
    }

    .ph-slot-chip-active-all {
        background: #1a1f2e !important;
        border-color: #1a1f2e !important;
        color: #fff !important;
        font-weight: 600 !important;
    }
</style>

@section Scripts
{
    <!--Walk-Ins-->
    <script>
        const dayLabels = @Html.Raw(Json.Serialize(ViewBag.DailyLabels));
        const dayData = @Html.Raw(Json.Serialize(ViewBag.DailyCounts));

        const hourLabels = @Html.Raw(Json.Serialize(ViewBag.HourLabels));
        const hourData = @Html.Raw(Json.Serialize(ViewBag.HourCounts));

        let chart;

        function createChart(labels, data) {
            if (chart) chart.destroy();

            const ctx = document.getElementById('trendChart').getContext('2d');

            chart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        data: data,
                        borderColor: '#1f2a44',
                        backgroundColor: 'transparent',
                        tension: 0.4,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        // default load
        createChart(dayLabels, dayData);

        // toggle
        document.getElementById('trendMode').addEventListener('change', function () {
            if (this.value === 'day') {
                createChart(dayLabels, dayData);
            } else {
                createChart(hourLabels, hourData);
            }
        });
    </script>
    <!--Leads by Car Model-->
    <script>
        const modelLabels = @Html.Raw(Json.Serialize(ViewBag.ModelLabels));
        const modelData = @Html.Raw(Json.Serialize(ViewBag.ModelCounts));

        const ctxModel = document.getElementById('modelChart').getContext('2d');

        new Chart(ctxModel, {
            type: 'bar',
            data: {
                labels: modelLabels,
                datasets: [{
                    data: modelData,
                    backgroundColor: '#1f2a44',
                    borderRadius: 6
                }]
            },
            options: {
                indexAxis: 'y', //  horizontal bars
                plugins: {
                    legend: { display: false }
                }
            }
        });
    </script>
    <!--Salesperson Performance-->
    <script>
        const salesLabels = @Html.Raw(Json.Serialize(ViewBag.SalesLabels));
        const salesData   = @Html.Raw(Json.Serialize(ViewBag.SalesCounts));

        const ctxSales = document.getElementById('salesChart').getContext('2d');

        new Chart(ctxSales, {
            type: 'bar',
            data: {
                labels: salesLabels,
                datasets: [{
                    data: salesData,
                    backgroundColor: '#f5b301',
                    borderRadius: 6
                }]
            },
            options: {
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, precision: 0 }
                    }
                }
            }
        });
    </script>
    <!--Follow-up Status-->
    <!--Follow-up Status-->
    <script>
                const statusData = [
                    @ViewBag.NotInterested,
                    @ViewBag.Pending,
                    @ViewBag.Contacted
                ];

                const ctxStatus = document.getElementById('statusChart').getContext('2d');

                new Chart(ctxStatus, {
                    type: 'doughnut',
                    data: {
                        labels: ['Not Interested', 'Pending', 'Contacted'],
                        datasets: [{
                            data: statusData,
                            backgroundColor: [
                                '#1f2a44', // dark
                                '#f5b301', // gold
                                '#6c7a91'  // gray
                            ]
                        }]
                    },
                options: {
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom'
                        }
                    }
                }
                });


        (function() {
            const MONTHS  = ['Dec','Jan','Feb','Mar','Apr','May'];
            const PALETTE = ['#0d6efd','#fd7e14','#198754','#6f42c1','#dc3545','#20c997','#6c757d','#ffc107'];

            const channelData = @Html.Raw(ViewBag.ChannelMonthlyJson ?? "[]");

            if (!channelData || channelData.length === 0) {
                document.getElementById('dashMiniLineChart')
                    .closest('div[style]').innerHTML =
                    '<p class="text-muted text-center pt-4" style="font-size:13px;">No channel data available yet.</p>';
                return;
            }

            new Chart(document.getElementById('dashMiniLineChart'), {
                type: 'line',
                data: {
                    labels: MONTHS,
                    datasets: channelData.map((c, i) => ({
                        label: c.channel,
                        data: c.monthlyCounts,
                        borderColor: PALETTE[i % PALETTE.length],
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        pointRadius: 2,
                        tension: 0.3
                    }))
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: { font: { size: 11 }, boxWidth: 10 }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0 } }
                    }
                }
            });
        })();


    </script>
    <!--Visitor Type-->
    <script>
        const visitorData = [
            @ViewBag.ReturningVisitors,
            @ViewBag.NewVisitors
        ];

        const ctxVisitor = document.getElementById('visitorChart').getContext('2d');

        new Chart(ctxVisitor, {
            type: 'doughnut',
            data: {
                labels: ['Returning', 'New'],
                datasets: [{
                    data: visitorData,
                    backgroundColor: [
                        '#1f2a44', // dark
                        '#f5b301'  // gold
                    ]
                }]
            },
            options: {
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                }
            }
        });
    </script>






    <!--Peak Hours-->
    <script>
        (function () {
            /* ── Data from controller ── */
            const PH_ALL_LABELS = @Html.Raw(Json.Serialize(ViewBag.PeakLabels));
            const PH_ALL_COUNTS = @Html.Raw(Json.Serialize(ViewBag.PeakCounts));
            const PH_BY_DAY     = @Html.Raw(ViewBag.PeakByDay);   // {Monday:[{hour,count},...], ...}

            /* Build all-time slots */
            const PH_ALL_SLOTS = PH_ALL_LABELS.map((lbl, i) => ({
                label: lbl, visitors: PH_ALL_COUNTS[i] || 0
            })).filter(s => s.visitors > 0);

            /* ── State ── */
            let phCurrentDay = "All";
            let phActiveSlot = "all";
            let phIsChart    = true;

            /* ── Helpers ── */
            function phGetSlots() {
                if (phCurrentDay === "All") return PH_ALL_SLOTS;
                const raw = PH_BY_DAY[phCurrentDay] || [];
                return raw.map(x => ({ label: x.hour, visitors: x.count }))
                          .filter(s => s.visitors > 0);
            }

           function phStatus(rank) {
            const lang = localStorage.getItem('siteLang') || 'en';
            const ar = lang === 'ar';
            if (rank === 0) return { cls:'busiest',  text: ar ? 'الأكثر ازدحاماً' : 'Busiest'  };
            if (rank === 1) return { cls:'high',     text: ar ? 'مرتفع'           : 'High'     };
            if (rank <= 3)  return { cls:'moderate', text: ar ? 'متوسط'           : 'Moderate' };
            return                  { cls:'low',     text: ar ? 'منخفض'           : 'Low'      };
        }
            const PH_BADGE = {
                busiest:  'background:#fff7e6;border:1.5px solid #fde8a8;color:#92400e;',
                high:     'background:#eaf3fb;border:1.5px solid #c3dff7;color:#1a5fa8;',
                moderate: 'background:#eafaf1;border:1.5px solid #bbf7d0;color:#166534;',
                low:      'background:#f1f5f9;border:1.5px solid #e8ecf2;color:#5a6175;'
            };

            /* Group hours into 2-hour slot windows for the Slot chips */
            function phBuildSlotWindows(slots) {
                const windows = {};
                slots.forEach(s => {
                    const h = parseInt(s.label);
                    const start = h % 2 === 0 ? h : h - 1;
                    const key = `${String(start).padStart(2,'0')}:00–${String(start+2).padStart(2,'0')}:00`;
                    if (!windows[key]) windows[key] = { label: key, visitors: 0 };
                    windows[key].visitors += s.visitors;
                });
                return Object.values(windows).sort((a,b) =>
                    parseInt(a.label) - parseInt(b.label));
            }

            /* ── Master render ── */
            function phRender() {
                const allSlots = phGetSlots();
                const ranked   = [...allSlots].sort((a,b) => b.visitors - a.visitors);
                const max      = ranked[0]?.visitors || 1;
                const top      = ranked[0];

                /* Badge */
        const badge = document.getElementById('phBadge');
        if (top) {
            const lang2 = localStorage.getItem('siteLang') || 'en';
            badge.textContent = top.label + (lang2 === 'ar' ? ' — الأكثر ازدحاماً' : ' — Busiest');
        } else {
            const lang2 = localStorage.getItem('siteLang') || 'en';
            badge.textContent = lang2 === 'ar' ? 'لا توجد بيانات' : 'No data';
        }

                /* Subtitle */
                const lang = localStorage.getItem('siteLang') || 'en';
        const ar = lang === 'ar';
        document.getElementById('phSubText').textContent =
            phCurrentDay === 'All'
                ? (ar ? 'حجم الزيارات بالساعة — كل الأوقات' : 'Walk-in volume by hour — all time')
                : (ar ? `حجم الزيارات بالساعة — ${phCurrentDay}` : `Walk-in volume by hour — ${phCurrentDay}`);
                /* Slot chips */
                phBuildSlotChips(allSlots);

                /* Filter by active slot if not "all" */
                const windows   = phBuildSlotWindows(allSlots);
                let visibleSlots = allSlots;
                if (phActiveSlot !== 'all') {
                    const [wStart, wEnd] = phActiveSlot.split('–').map(t => parseInt(t));
                    visibleSlots = allSlots.filter(s => {
                        const h = parseInt(s.label); return h >= wStart && h < wEnd;
                    });
                }

                /* No data state */
                const noData = document.getElementById('phNoData');
                if (!visibleSlots.length) {
                    document.getElementById('phViewChart').style.display  = 'none';
                    document.getElementById('phViewRanked').style.display = 'none';
                    noData.style.display = 'block';
                    return;
                }
                noData.style.display = 'none';

                const visRanked = [...visibleSlots].sort((a,b) => b.visitors - a.visitors);
                const visMax    = visRanked[0].visitors;

                phIsChart ? phRenderChart(visibleSlots, visRanked, visMax)
                          : phRenderRanked(visRanked, visMax);
            }

            /* ── Slot chips ── */
            function phBuildSlotChips(slots) {
                const container = document.getElementById('phSlotChips');
                container.innerHTML = '';
                const windows = phBuildSlotWindows(slots);

                const allChip = document.createElement('span');
                allChip.className = 'ph-slot-chip' +
                    (phActiveSlot === 'all' ? ' ph-slot-chip-active-all ph-slot-chip-active' : '');
                const lang = localStorage.getItem('siteLang') || 'en';
        allChip.textContent = lang === 'ar' ? 'كل الفترات' : 'All Slots';
                allChip.onclick = () => { phActiveSlot = 'all'; phRender(); };
                container.appendChild(allChip);

                windows.forEach(w => {
                    const c = document.createElement('span');
                    c.className = 'ph-slot-chip' +
                        (phActiveSlot === w.label ? ' ph-slot-chip-active' : '');
                    c.textContent = w.label + ' (' + w.visitors + ')';
                    c.onclick = () => { phActiveSlot = w.label; phRender(); };
                    container.appendChild(c);
                });
                // Translate day chip buttons
        // Always map using data-en attribute so switching back to English works
        const arDays = { All: 'الكل', Mon: 'الإثنين', Tue: 'الثلاثاء', Wed: 'الأربعاء', Thu: 'الخميس', Fri: 'الجمعة', Sat: 'السبت', Sun: 'الأحد' };

        document.querySelectorAll('.ph-day-chip').forEach(btn => {
            // Save original English text on first run
            if (!btn.dataset.en) btn.dataset.en = btn.innerText.trim();
            const enText = btn.dataset.en;
            btn.innerText = lang === 'ar' ? (arDays[enText] || enText) : enText;
        }); }

            /* ── VIEW A: Hourly chart ── */
            function phRenderChart(chrono, ranked, max) {
                document.getElementById('phViewChart').style.display  = 'block';
                document.getElementById('phViewRanked').style.display = 'none';

                const CHART_H = 220;
                const step    = Math.max(1, Math.ceil(max / 4));
                const yAxis   = document.getElementById('phYAxis');
                const grid    = document.getElementById('phGridLines');
                yAxis.innerHTML = grid.innerHTML = '';

                for (let v = max; v >= 0; v -= step) {
                    const t = document.createElement('div');
                    t.style.cssText = 'font-size:.68rem;color:#9ca3af;line-height:1;';
                    t.textContent = v;
                    yAxis.appendChild(t);
                    const l = document.createElement('div');
                    l.style.cssText = 'width:100%;border-top:1px dashed #e8ecf2;';
                    grid.appendChild(l);
                }

                const colsRow = document.getElementById('phColsRow');
                const xRow    = document.getElementById('phXRow');
                colsRow.innerHTML = xRow.innerHTML = '';

                chrono.forEach(slot => {
                    const isTop = slot.label === ranked[0].label;
                    const barH  = Math.max(4, Math.round((slot.visitors / max) * CHART_H));
                    const color = isTop
                        ? 'linear-gradient(180deg,#f5c842,#f5a623)'
                        : 'linear-gradient(180deg,#74b3ec,#4a90d9)';

                    const wrap = document.createElement('div');
                    wrap.style.cssText = 'flex:1;display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;';
                    wrap.innerHTML = `
                        <div style="font-size:.7rem;font-weight:700;color:#5a6175;margin-bottom:4px;">${slot.visitors}</div>
                        <div class="ph-col-bar" data-h="${barH}px"
                             style="width:100%;border-radius:6px 6px 0 0;background:${color};
                                    height:0;transition:height .5s cubic-bezier(.4,0,.2,1);"></div>`;
                    colsRow.appendChild(wrap);

                    const xl = document.createElement('div');
                    xl.style.cssText = 'flex:1;text-align:center;font-size:.62rem;color:#9ca3af;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;';
                    xl.textContent = slot.label;
                    xRow.appendChild(xl);
                });

                requestAnimationFrame(() => {
                    document.querySelectorAll('.ph-col-bar').forEach(b => {
                        b.style.height = b.dataset.h;
                    });
                });
            }

            /* ── VIEW B: Ranked bars ── */
            function phRenderRanked(ranked, max) {
                document.getElementById('phViewChart').style.display  = 'none';
                const area = document.getElementById('phViewRanked');
                area.style.display = 'flex';
                area.innerHTML = '';

                ranked.forEach((slot, i) => {
                    const pct    = (slot.visitors / max * 100).toFixed(1);
                    const status = phStatus(i);
                    const isTop  = i === 0;
                    const rowBg  = isTop ? 'background:#fff7e6;border:1.5px solid #fde8a8;'
                                         : 'border:1.5px solid transparent;';
                    const barClr = isTop
                        ? 'linear-gradient(90deg,#f5a623,#f0cd6a)'
                        : 'linear-gradient(90deg,#4a90d9,#74b3ec)';

                    const row = document.createElement('div');
                    row.style.cssText = `display:grid;grid-template-columns:22px 1fr 2fr 46px 96px;
                        align-items:center;gap:12px;padding:11px 14px;border-radius:10px;${rowBg}`;
                    row.innerHTML = `
                        <span style="font-size:.8rem;font-weight:700;color:${isTop?'#f5a623':'#9ca3af'};">${i+1}</span>
                        <span style="font-size:.88rem;font-weight:600;color:#1a1f2e;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${slot.label}</span>
                        <div style="background:#f0f4f8;border-radius:99px;height:28px;overflow:hidden;">
                            <div class="ph-bar-fill" data-target="${pct}"
                                 style="height:100%;border-radius:99px;background:${barClr};width:0;
                                        display:flex;align-items:center;justify-content:flex-end;
                                        padding-right:10px;font-size:.74rem;font-weight:700;color:#fff;
                                        transition:width .5s cubic-bezier(.4,0,.2,1);">${slot.visitors}</div>
                        </div>
                        <span style="font-size:1rem;font-weight:700;color:#1a1f2e;text-align:right;">${slot.visitors}</span>
                        <span style="padding:5px 12px;border-radius:20px;font-size:.72rem;font-weight:700;text-align:center;${PH_BADGE[status.cls]}">${status.text}</span>`;
                    area.appendChild(row);
                });

                requestAnimationFrame(() => {
                    document.querySelectorAll('.ph-bar-fill').forEach(b => {
                        b.style.width = b.dataset.target + '%';
                    });
                });
            }

            /* ── Day selector ── */
            window.phSetDay = function(day, el) {
                phCurrentDay = day;
                phActiveSlot = 'all';
                document.querySelectorAll('.ph-day-chip').forEach(c => c.classList.remove('ph-day-active'));
                el.classList.add('ph-day-active');
                phRender();
            };

            /* ── Date picker → auto-select day chip ── */
            window.phOnDatePick = function(val) {
                if (!val) return;
                const days = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
                const name = days[new Date(val + "T00:00:00").getDay()];
                phCurrentDay = name;
                phActiveSlot = 'all';
                document.querySelectorAll('.ph-day-chip').forEach(c => {
                    const matches = c.textContent.trim() === name.slice(0,3) || c.textContent.trim() === 'All';
                    c.classList.toggle('ph-day-active', c.textContent.trim() === name.slice(0,3));
                });
                phRender();
            };

            /* ── Toggle ── */
            /* ── Toggle ── */
        window.phOnToggle = function(checked) {
            phIsChart = !checked;
            document.getElementById('phSlider').style.background = checked ? '#f5a623' : '#cbd5e1';
            document.getElementById('phKnob').style.transform    = checked ? 'translateX(21px)' : 'translateX(0)';
            document.getElementById('phLblLeft').style.cssText   = !checked
                ? 'font-size:.78rem;font-weight:700;color:#1a1f2e;'
                : 'font-size:.78rem;font-weight:500;color:#9ca3af;';
            document.getElementById('phLblRight').style.cssText  = checked
                ? 'font-size:.78rem;font-weight:700;color:#1a1f2e;'
                : 'font-size:.78rem;font-weight:500;color:#9ca3af;';
            phRender();
        };

            /* ── Last Updated ── */
            document.getElementById('phLastUpdated').textContent =
                'Today, ' + new Date().toLocaleTimeString([], { hour:'2-digit', minute:'2-digit' });

            /* ── Init ── */
            phRender();
        })();


    </script>

