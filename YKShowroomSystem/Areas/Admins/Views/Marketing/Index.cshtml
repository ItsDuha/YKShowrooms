/* — Builds the PDF */
async function printReportPDF() {
    const { jsPDF } = window.jspdf;
    const lang = localStorage.getItem('siteLang') || 'en';
   
 
    /* ── gather same data as generateReport ── */
    const kpiEl      = document.getElementById('kpi-total-visitors');
    const kpiTotal   = kpiEl ? parseInt(kpiEl.textContent.replace(/,/g,''), 10) : null;
    const mayT       = CHANNEL_MONTHLY.map(c => c.monthlyCounts[5]);
    const aprT       = CHANNEL_MONTHLY.map(c => c.monthlyCounts[4]);
    const mayChTotal = mayT.reduce((s,v)=>s+v, 0);
    const aprTotal   = aprT.reduce((s,v)=>s+v, 0);
    const displayTotal = kpiTotal !== null && !isNaN(kpiTotal) ? kpiTotal : mayChTotal;
    const growthBase = aprTotal > 0
        ? (((displayTotal - aprTotal) / aprTotal) * 100).toFixed(1)
        : '0.0';
    const growthNum  = parseFloat(growthBase);
    const growthSign = growthNum > 0 ? '+' : '';
    const topIdx     = mayT.indexOf(Math.max(...mayT));
    const topCh      = CHANNELS[topIdx] || 'N/A';
    const topChPct   = mayChTotal > 0 ? ((mayT[topIdx]/mayChTotal)*100).toFixed(1) : '0';
    const budgetInput   = document.getElementById('budgetInputBox');
    const currentBudget = parseFloat(budgetInput ? budgetInput.value : '2000') || 2000;
    const topBHD        = mayChTotal > 0 ? ((mayT[topIdx]/mayChTotal)*currentBudget).toFixed(0) : '0';
    const avgR        = FEEDBACK_DATA.length
        ? (FEEDBACK_DATA.reduce((s,f)=>s+f.rating,0)/FEEDBACK_DATA.length).toFixed(1)
        : null;
    const totalReviews = FEEDBACK_DATA.length;
 
    const trendWord = growthNum > 0 ? 'increased' : growthNum < 0 ? 'decreased' : 'remained stable';
 
    const monthYear     = new Date().toLocaleString('en-US',{month:'long',year:'numeric'});
    const generatedDate = new Date().toLocaleDateString('en-GB',{day:'numeric',month:'long',year:'numeric'});
 
    /* ── sorted channels for table ── */
    const sortedChannels = [...CHANNEL_MONTHLY]
        .map((c,i) => ({ name: c.channel, count: mayT[i] }))
        .filter(c => c.count > 0)
        .sort((a,b) => b.count - a.count);
 
    /* ── low channels ── */
    const lowChannels = sortedChannels
        .filter(c => mayChTotal > 0 && (c.count/mayChTotal) < 0.10)
        .map(c => c.name);
 
    /* ── load logo ── */
    const logoBase64 = await _imgToBase64('/images/logo.png');
 
    /* ── build PDF ── */
    const doc = new jsPDF({ unit: 'mm', format: 'a4' });
    const PW = 210, PH = 297;
    const ML = 14, MR = 14, MT = 22, textWidth = PW - ML - MR;
    let y = MT;
 
    const NAVY = [0, 43, 91];
    const RED  = [200, 16, 46];
    const GRAY = [108, 117, 125];
    const DARK = [50, 58, 64];
 
    /* helper: add new page when near bottom */
    function checkPage(needed) {
        if (y + needed > PH - 20) {
            doc.addPage();
            y = MT;
        }
    }
 
    /* helper: section heading */
    function sectionHead(label) {
        checkPage(12);
        doc.setFillColor(...RED);
        doc.rect(ML, y, 2.5, 7, 'F');
        doc.setFont('helvetica','bold');
        doc.setFontSize(8);
        doc.setTextColor(...NAVY);
        doc.text(label.toUpperCase(), ML + 5, y + 5.5);
        y += 10;
    }
 
    /* helper: body paragraph */
    function bodyPara(text) {
        doc.setFont('helvetica','normal');
        doc.setFontSize(9);
        doc.setTextColor(...DARK);
        const lines = doc.splitTextToSize(text, textWidth);
        checkPage(lines.length * 5 + 4);
        doc.text(lines, ML, y);
        y += lines.length * 5 + 4;
    }
 
    /* ── HEADER BAR ── */
    doc.setFillColor(...NAVY);
    doc.rect(0, 0, PW, 22, 'F');
    doc.setDrawColor(...RED);
    doc.setLineWidth(1);
    doc.line(0, 22, PW, 22);
 
    if (logoBase64) {
        doc.addImage(logoBase64, 'PNG', ML, 2, 16, 16);
    }
    doc.setFont('helvetica','bold');
    doc.setFontSize(12);
    doc.setTextColor(255,255,255);
    doc.text('Y.K. Almoayyed & Sons', logoBase64 ? ML + 19 : ML, 11);
    doc.setFont('helvetica','normal');
    doc.setFontSize(8);
    doc.setTextColor(200,210,225);
    doc.text(`Monthly Executive Marketing Report  |  ${SHOWROOM_NAME}  |  ${monthYear}`, logoBase64 ? ML + 19 : ML, 17);
 
    y = 32; // start below header
 
    /* ── 1. PERFORMANCE OVERVIEW ── */
    sectionHead('Performance Overview');
    bodyPara(
        `In ${monthYear}, ${SHOWROOM_NAME} received ${displayTotal.toLocaleString()} visitor${displayTotal!==1?'s':''}. ` +
        `Compared to April (${aprTotal.toLocaleString()}), traffic ${trendWord} by ${growthSign}${growthBase}%. ` +
        (growthNum > 0
            ? 'This growth shows the current marketing channels are reaching the right audience.'
            : growthNum < 0
            ? 'This drop is worth investigating - certain channels may need a refresh or timing shift.'
            : 'Traffic held steady, indicating consistent marketing performance.')
    );
 
    /* ── 2. WHERE VISITORS ARE COMING FROM ── */
    sectionHead('Where Visitors Are Coming From');
    bodyPara(
        `The top channel this month is ${topCh} (${topChPct}% of all visitors), ` +
        `making it the most effective way to reach customers right now. ` +
        `The table below shows the full breakdown:`
    );
    y += 2;
 
    /* channel table */
    const colX   = [ML, ML+52, ML+90, ML+122, ML+160];
    const colW   = [50, 36,    30,    36,      30    ];
    const headers = ['Channel','Visitors','Share','Suggested Budget',''];
 
    checkPage(10 + sortedChannels.length * 8);
 
    // header row
    doc.setFillColor(241,243,245);
    doc.rect(ML, y, textWidth, 8, 'F');
    doc.setFont('helvetica','bold');
    doc.setFontSize(8);
    doc.setTextColor(...GRAY);
    ['Channel','Visitors This Month','Share','Suggested Budget'].forEach((h,i) => {
        doc.text(h, colX[i]+1, y+5.5);
    });
    y += 8;
 
    sortedChannels.forEach((c,idx) => {
        if (idx % 2 === 0) {
            doc.setFillColor(249,250,251);
            doc.rect(ML, y, textWidth, 7, 'F');
        }
        const pct = mayChTotal > 0 ? ((c.count/mayChTotal)*100).toFixed(1) : '0.0';
        const bhd = mayChTotal > 0 ? ((c.count/mayChTotal)*currentBudget).toFixed(0) : '0';
        doc.setFont('helvetica','normal');
        doc.setFontSize(8.5);
        doc.setTextColor(...DARK);
        doc.text(c.name,              colX[0]+1, y+4.8);
        doc.text(String(c.count),     colX[1]+18, y+4.8, {align:'right'});
        doc.text(`${pct}%`,           colX[2]+14, y+4.8, {align:'right'});
        doc.setFont('helvetica','bold');
        doc.setTextColor(...NAVY);
        doc.text(`BHD ${Number(bhd).toLocaleString()}`, colX[3]+32, y+4.8, {align:'right'});
        doc.setTextColor(...DARK);
        y += 7;
    });
    y += 4;
 
    /* ── 3. BUDGET ── */
    sectionHead('Where to Put the Marketing Budget');
    bodyPara(
        `With a monthly budget of BHD ${Number(currentBudget).toLocaleString()}, ` +
        `the idea is to put more money into the channels that are actually bringing people in. ` +
        `${topCh} is the top performer, so the suggested spend is BHD ${Number(topBHD).toLocaleString()} this month.` +
        (lowChannels.length > 0
            ? ` Channels with fewer visitors (${lowChannels.join(', ')}) should get less budget or be reviewed.`
            : '')
    );
 
    /* ── 4. CUSTOMER FEEDBACK ── */
    sectionHead('Customer Feedback & Satisfaction');
    if (avgR) {
        const oneStars = FEEDBACK_DATA.filter(f=>f.rating===1).length;
        const sat = parseFloat(avgR) >= 4 ? 'good' : parseFloat(avgR) >= 3 ? 'average' : 'below expectations';
        bodyPara(
            `Visitors rated their experience ${avgR}/5 across ${totalReviews} review${totalReviews!==1?'s':''}. ` +
            `Satisfaction is ${sat}. ` +
            (parseFloat(avgR) < 4 && oneStars > 0
                ? `There are ${oneStars} low rating(s) worth reviewing to understand what went wrong and how to fix it.`
                : 'Keep collecting feedback after every visit to monitor service quality.')
        );
    } else {
        bodyPara('No visitor feedback data is available yet for this period.');
    }
 
    /* ── 5. RECOMMENDATIONS ── */
    sectionHead('Recommendations');
    const recs = [
        `Put more of the marketing budget into ${topCh} — it is bringing in the most visitors.`,
        `Keep rewarding the sales team — happy staff deliver better service and better reviews.`,
        avgR && parseFloat(avgR) < 4
            ? `Read through the low-rated reviews and follow up — small fixes can make a big difference.`
            : `Continue collecting visitor feedback after every visit to track what is working.`,
        `Review channels with very few visitors and consider reducing spend on them.`
    ];
    recs.forEach((r, i) => {
        checkPage(10);
        doc.setFont('helvetica','bold');
        doc.setFontSize(9);
        doc.setTextColor(...NAVY);
        doc.text(`${i+1}.`, ML, y);
        doc.setFont('helvetica','normal');
        doc.setTextColor(...DARK);
        const lines = doc.splitTextToSize(r, textWidth - 7);
        doc.text(lines, ML + 7, y);
        y += lines.length * 5 + 3;
    });
 
    /* ── FOOTER ── */
    doc.setDrawColor(220,220,220);
    doc.setLineWidth(0.3);
    doc.line(ML, PH - 14, PW - MR, PH - 14);
    doc.setFont('helvetica','normal');
    doc.setFontSize(7);
    doc.setTextColor(180,180,180);
    doc.text(`Generated on ${generatedDate}`, ML, PH - 9);
    doc.text(`Showroom: ${SHOWROOM_NAME}  |  System: Marketing Dashboard`, PW - MR, PH - 9, {align:'right'});
 
    doc.save(`YK_Marketing_Report_${SHOWROOM_NAME.replace(/\s+/g,'_')}_${new Date().toISOString().split('T')[0]}.pdf`);
}
