function translateMKPage(lang) {
    const t = mkTranslations[lang];
    if (!t) return;
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.innerText = val; };

    set('txt-mk-title',            t.pageTitle);
    set('txt-mk-showroom-label',   t.showroomLabel);
    set('txt-mk-all-showrooms',    t.allShowrooms);
    set('txt-mk-date-range',       t.dateRange);
    set('txt-mk-pdf-btn',          t.pdfBtn);
    set('txt-mk-excel-btn',        t.excelBtn);
    set('txt-kpi-visitors',        t.kpiVisitors);
    set('txt-kpi-visitors-sub',    t.kpiVisitorsSub);
    set('txt-kpi-channel',         t.kpiChannel);
    set('txt-kpi-channel-sub',     t.kpiChannelSub);
    set('txt-kpi-rating',          t.kpiRating);
    set('txt-kpi-rating-sub',      t.kpiRatingSub);
    set('txt-kpi-salesperson',     t.kpiSalesperson);
    set('txt-kpi-salesperson-sub', t.kpiSalespersonSub);
    set('txt-src-title',           t.srcTitle);
    set('txt-src-sub',             t.srcSub);
    set('txt-toggle-pie',          t.togglePie);
    set('txt-toggle-line',         t.toggleLine);
    set('txt-pie-label',           t.pieLabel);
    set('txt-line-label',          t.lineLabel);
    set('txt-report-title',        t.reportTitle);
    set('txt-report-sub',          t.reportSub);
    set('txt-report-generate',     t.reportGenerate);
    set('txt-report-pdf',          t.reportPdf);
    set('txt-report-word',         t.reportWord);   // ✅ NEW
    set('txt-report-excel',        t.reportExcel);
    const placeholder = document.getElementById('txt-report-placeholder');
    if (placeholder) placeholder.innerText = t.reportPlaceholder;
    set('txt-fb-title',            t.fbTitle);
    set('txt-fb-sub',              t.fbSub);
    set('txt-filter-all-ratings',  t.filterAllRatings);
    set('txt-filter-clear',        t.filterClear);
    set('txt-filter-csv',          t.filterCsv);
    set('txt-fb-th-visitor',       t.fbThVisitor);
    set('txt-fb-th-rating',        t.fbThRating);
    set('txt-fb-th-comment',       t.fbThComment);
    set('txt-fb-th-showroom',      t.fbThShowroom);
    set('txt-fb-th-date',          t.fbThDate);
    set('txt-fb-th-action',        t.fbThAction);
    set('txt-modal-title',         t.modalTitle);
    set('txt-modal-cancel',        t.modalCancel);
    set('txt-modal-send',          t.modalSend);
    set('txt-report-clear',        t.reportClear);
    set('txt-budget-title',        t.budgetTitle);
    set('txt-budget-sub',          t.budgetSub);
    set('txt-budget-label',        t.budgetLabel);
    set('txt-line-title-card', t.lineTitleCard);
set('txt-line-sub-card',   t.lineSubCard);
set('txt-src-sub-card',    t.srcSubCard);

    const budgetInput = document.getElementById('budgetInputBox');
    recalcBudget(budgetInput ? budgetInput.value : BUDGET_TOTAL);
    renderFeedback(filteredFeedback.length ? filteredFeedback : FEEDBACK_DATA);
}

